            mass: 0.025,
            cost: 200,
            size: Tiny,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 2.0,
            decoupler: Some((
                ejection_force: 10.0,
                is_radial: true,
            )),
        ),

        // === FAIRINGS ===
        // Payload shrouds that protect parts from aerodynamic heating.
        // Place the base, then click to build a symmetric fairing shell above it.
        // 1 grid square tall disc, fully colored in.

        (
            id: "fairing_tiny",
            name: "AE-FF0 Fairing",
