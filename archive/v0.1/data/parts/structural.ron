            size: XL,
            shape: Rectangle,
            grid_width: 13.0,
            grid_height: 0.5,
            hitbox_height: Some(1),
            decoupler: Some((
                ejection_force: 100.0,
            )),
        ),

        // === RADIAL DECOUPLERS ===
        // Separates horizontally instead of vertically.
        // Used for side-mounted boosters.

        (
            id: "decoupler_radial",
            name: "TT-38K Radial Decoupler",
            description: "Radial decoupler for side-mounted boosters.",
