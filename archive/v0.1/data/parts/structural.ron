// Structural Part Definitions

(
    parts: [
        // === DECOUPLERS ===
        // Thin ring-shaped parts that separate stages.
        // Visual height is 0.5 grid squares (drawn on bottom half of 1-square hitbox).

        (
            id: "decoupler_tiny",
            name: "TD-1 Decoupler",
            description: "Tiny stack decoupler for probe-scale vehicles.",
            category: Structural,
            mass: 0.01,
            cost: 50,
            size: Tiny,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 0.5,
            hitbox_height: Some(1),
            decoupler: Some((
                ejection_force: 5.0,
            )),
        ),
        (
            id: "decoupler_small",
