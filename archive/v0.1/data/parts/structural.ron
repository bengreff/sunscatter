            grid_height: 0.5,
            hitbox_height: Some(1),
            decoupler: Some((
                ejection_force: 15.0,
            )),
        ),
        (
            id: "decoupler_medium",
            name: "TD-25 Decoupler",
            description: "Medium stack decoupler for standard interstages.",
