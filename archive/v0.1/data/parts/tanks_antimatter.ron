        (
            id: "tank_am_large",
            name: "AM-9",
            description: "Heavy Penning trap complex. Nine-cell toroidal array surrounds a central cryogenic core. Triple-redundant active confinement and quench-resistant interlocks make this the largest antimatter store rated for combat-class deceleration burns.",
            category: FuelTanks,
            mass: 0.484,
            cost: 1200000,
            size: Large,
            shape: Rectangle,
            grid_width: 9.0,
