// Antimatter Containment Tank Definitions
// Penning trap arrays for proton-antiproton storage.
// Magnetic confinement in ultra-high-vacuum chambers cooled to ~4 K.
// Mass is dominated by superconducting magnets, cryocoolers, and
// radiation-hardened structural vessel.
// Dimensions mirror the xenon tank lineup (Tiny/Small/Medium/Large).
// Fuel type is locked to Antimatter — these tanks cannot hold anything else.

(
    parts: [
        // ============================================
        // TINY ANTIMATTER TANK (1x1 grid)
        // ============================================

        (
            id: "tank_am_tiny",
            name: "AM-1",
            description: "Miniature Penning trap cell. A single magnetic-bottle chamber suspends a few grams of antiprotons for catalyst doses or research samples. Built-in cryocooler maintains 4 K. Not practical as a primary fuel store — its real role is feeding antimatter-catalyzed fusion engines.",
            category: FuelTanks,
            mass: 0.016,
            cost: 150000,
            size: Tiny,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 1.0,
            tank: Some((
                grid_area: 0.4,
                fixed_fuel_type: Some(Antimatter),
            )),
            resources: {},
        ),

        // ============================================
