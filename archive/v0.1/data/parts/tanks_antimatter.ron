        // ============================================
        // ENDGAME ANTIMATTER SPHERES
        // ============================================
        // Same outer dimensions as the fusion spheres (20x20, 40x40, 60x60)
        // but built around an advanced bulk-containment field rather than a
        // Penning-trap array — they store antimatter at industrial scales,
        // not gram quantities. Capacity per part matches what the matching
        // fusion sphere would hold as LH2 (140 kg per sphere grid-square
        // volume unit). To achieve that with the global Antimatter density
        // of 5 kg/grid-area, the per-tank `grid_area` is inflated by 28×
        // relative to the fusion sphere's value — this is a "containment
        // efficiency" abstraction, not a physical-volume number. Dry mass
        // is 2× the corresponding fusion sphere to reflect the heavier
        // reinforcement and active-field generators.

        (
            id: "tank_am_sphere_s",
            name: "AM Sphere S",
            description: "Bulk antimatter storage vessel, small. Advanced topological-confinement field generators around a heavily reinforced 10 m spherical pressure hull replace the Penning-trap arrays of earlier tanks. Holds tonnes of antiprotons rather than grams. Sized for probe-class antimatter-torch missions.",
            category: FuelTanks,
            mass: 10.388,
