        // Inertial confinement D+He3 fusion, second stage
        // ============================================

        (
            id: "engine_daedalus_s2",
            name: "Daedalus Stage 2",
            description: "Compact second-stage variant of the Daedalus fusion drive. Same inertial confinement principle at reduced scale — lower pellet injection rate trades thrust for structural savings. Exhaust velocity of 9,210 km/s per BIS study specification. Optimized for cruise acceleration after the first stage separates.",
            category: Interstellar,
            mass: 1000.0,
            cost: 5000000,
            size: XL,
            shape: Trapezoid,
