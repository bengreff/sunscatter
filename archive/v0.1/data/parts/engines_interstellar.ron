        // AM-initiated fusion for high efficiency
        // ============================================

        (
            id: "engine_amcat_fusion",
            name: "AM-Cat Fusion",
            description: "Antimatter-catalyzed fusion engine. Antiprotons (0.24% by fuel mass) injected into a D+He3 target initiate fusion without massive driver hardware — no electron beams, no giant magnetic bottles. Exhaust velocity of 30,000 km/s. Compact and efficient: the antimatter is a catalyst, not the primary fuel, so consumption is remarkably low.",
            category: Interstellar,
            mass: 600.0,
            cost: 10000000,
            size: XL,
