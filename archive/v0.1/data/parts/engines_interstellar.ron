// Interstellar Engine Definitions
// Eight engines across three technology tiers: Nuclear Pulse, Fusion, Antimatter.
// All vacuum-only (no atmospheric thrust). Massive Isp values for interstellar delta-v.
// Thrust in kN. Isp = exhaust_velocity(m/s) / 9.80665.
// Masses are engine-only — radiators and reactors are separate ship parts.

(
    parts: [
        // ============================================
        // NUCLEAR PULSE — Orion Pulse Drive
        // Propelled by sequential nuclear detonations
        // ============================================

        (
            id: "engine_orion_pulse",
            name: "Orion Pulse Drive",
            description: "Nuclear pulse propulsion system. A massive pusher plate absorbs the force of sequential nuclear detonations, each launching a shaped-charge fission bomb behind the ship. Brutal thrust, moderate efficiency. The only interstellar drive you can build with 1960s technology — if you don't mind the fallout.",
            category: Interstellar,
            mass: 3500.0,
            cost: 5000000,
            size: XL,
            shape: Trapezoid,
            grid_width: 70.0,
            grid_height: 52.0,
            top_width: Some(30.0),
            hitbox_width: Some(71),
            flight_hitbox_width: Some(70.00),
            flight_hitbox_height: Some(52.00),
            engine: Some((
                thrust_vac: 60000.0,
                thrust_asl: 0.0,
                isp_vac: 4079.0,
                isp_asl: 0.0,
                throttleable: false,
                gimbal_range: 0.0,
                propellant: NuclearPulse,
                alternator_power: 50000000.0,
                waste_heat_watts: 60000000000.0, // 60 GW — Orion pulse (2% of 3 TW reaction power)
            )),
            resources: {},
        ),

        // ============================================
        // FUSION — Daedalus Stage 1
        // Inertial confinement D+He3 fusion, first stage
        // ============================================

        (
            id: "engine_daedalus_s1",
            name: "Daedalus Stage 1",
            description: "Massive inertial confinement fusion engine based on the BIS Project Daedalus study. Electron beams ignite D+He3 fuel pellets at 250 per second, expelling fusion plasma at 10,600 km/s. Designed as a first-stage booster — the heaviest fusion engine, built for raw delta-v. The magnetic nozzle alone masses more than most spacecraft.",
            category: Interstellar,
            mass: 2000.0,
            cost: 8000000,
            size: XL,
            shape: Trapezoid,
            grid_width: 60.0,
            grid_height: 48.0,
            top_width: Some(20.0),
            hitbox_width: Some(61),
            flight_hitbox_width: Some(60.00),
            flight_hitbox_height: Some(48.00),
            engine: Some((
                thrust_vac: 7000.0,
                thrust_asl: 0.0,
                isp_vac: 1080856.0,
                isp_asl: 0.0,
                throttleable: false,
                gimbal_range: 0.0,
                propellant: FusionFuel,
                alternator_power: 100000000.0,
                waste_heat_watts: 1050000000000.0, // 1.05 TW — Daedalus S1 (3% of 35 TW reaction)
            )),
            resources: {},
        ),

        // ============================================
