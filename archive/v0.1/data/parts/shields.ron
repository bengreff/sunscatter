// Interstellar Shield Definitions
// Nine shields across three types (Whipple, FRES, Geodesic) × three sizes.
// Whipple shields are passive (no power). FRES and Geodesic require reactor power.
// All shields rated for their max velocity as a fraction of c.

(
    parts: [
        // ============================================
        // WHIPPLE SHIELDS — Passive debris protection
        // Effective up to 0.1c (10% lightspeed)
        // ============================================

        (
            id: "shield_whipple_small",
            name: "Whipple Shield S",
            description: "Small multi-layer Whipple shield. Spaced aluminum and Kevlar sheets shatter incoming micrometeoroids into harmless plasma before they reach the hull. No power required — purely passive protection. Rated for velocities up to 0.1c, beyond which kinetic energy overwhelms material strength.",
            category: Interstellar,
            mass: 150.0,
            cost: 100000,
            size: Large,
            shape: Rectangle,
            grid_width: 9.0,
            grid_height: 3.0,
            shield: Some((
                shield_type: Whipple,
                max_velocity_c: 0.1,
                power_base_watts: 0.0,
            )),
            resources: {},
        ),

        (
            id: "shield_whipple_medium",
            name: "Whipple Shield M",
            description: "Medium multi-layer Whipple shield with additional ceramic fiber layers for improved debris fragmentation. Provides passive protection for medium-class interstellar vessels. The workhorse shield for early interstellar missions within the 0.1c speed regime.",
            category: Interstellar,
            mass: 600.0,
            cost: 300000,
            size: XL,
            shape: Rectangle,
            grid_width: 13.0,
            grid_height: 5.0,
            shield: Some((
                shield_type: Whipple,
                max_velocity_c: 0.1,
                power_base_watts: 0.0,
            )),
            resources: {},
        ),

        (
            id: "shield_whipple_large",
            name: "Whipple Shield L",
            description: "Large multi-layer Whipple shield with 20+ spaced layers of graded-density material. Maximum passive protection for capital-class vessels. At 0.1c, even a grain of sand carries the energy of a hand grenade — this shield turns it into a puff of plasma across multiple ablation layers.",
            category: Interstellar,
            mass: 2400.0,
            cost: 800000,
            size: XL,
            shape: Rectangle,
            grid_width: 19.0,
            grid_height: 5.0,
            shield: Some((
                shield_type: Whipple,
                max_velocity_c: 0.1,
                power_base_watts: 0.0,
            )),
            resources: {},
        ),

        // ============================================
        // FRES SHIELDS — Fluid Recirculating EM Shield
        // Active protection up to 0.85c
        // ============================================

        (
            id: "shield_fres_small",
            name: "FRES Shield S",
            description: "Small Fluid Recirculating Electromagnetic Shield. A high-temperature superconducting magnet generates a powerful magnetic field that deflects charged particles, while a circulating liquid metal layer absorbs neutral debris. Requires continuous reactor power but protects up to 0.85c.",
            category: Interstellar,
            mass: 150.0,
            cost: 500000,
            size: Large,
            shape: Rectangle,
            grid_width: 9.0,
            grid_height: 9.0,
            shield: Some((
                shield_type: FRES,
                max_velocity_c: 0.85,
                power_base_watts: 1000000000.0,
            )),
            resources: {},
        ),

        (
            id: "shield_fres_medium",
            name: "FRES Shield M",
            description: "Medium FRES shield with extended magnetic field geometry. Dual superconducting coil arrays create overlapping deflection zones for improved coverage. The liquid metal recirculation system self-heals after impacts, maintaining protection through sustained bombardment.",
            category: Interstellar,
            mass: 375.0,
            cost: 1200000,
            size: XL,
            shape: Rectangle,
            grid_width: 13.0,
            grid_height: 11.0,
            shield: Some((
                shield_type: FRES,
                max_velocity_c: 0.85,
                power_base_watts: 2000000000.0,
            )),
            resources: {},
        ),

        (
            id: "shield_fres_large",
            name: "FRES Shield L",
            description: "Large FRES shield for capital-class interstellar vessels. Triple-redundant superconducting magnet arrays with independent liquid metal circuits provide maximum electromagnetic protection. At 0.85c, the interstellar medium itself becomes a hazard — this shield turns it into a manageable plasma flow.",
            category: Interstellar,
            mass: 1200.0,
            cost: 3000000,
            size: XL,
            shape: Rectangle,
            grid_width: 17.0,
            grid_height: 13.0,
            shield: Some((
                shield_type: FRES,
                max_velocity_c: 0.85,
                power_base_watts: 4000000000.0,
            )),
            resources: {},
        ),

        // ============================================
        // GEODESIC SHIELDS — Force field projection
        // Active protection up to 0.85c, highest power
        // ============================================

        (
            id: "shield_geodesic_small",
            name: "Geodesic Shield S",
            description: "Small geodesic force field generator. Projects a tessellated electromagnetic containment field in a geodesic sphere pattern, vaporizing incoming matter at a safe standoff distance. Enormous power draw but provides the ultimate protection for interstellar travel at relativistic velocities.",
            category: Interstellar,
            mass: 400.0,
            cost: 2000000,
            size: Large,
            shape: Rectangle,
            grid_width: 9.0,
            grid_height: 9.0,
            shield: Some((
                shield_type: Geodesic,
                max_velocity_c: 0.85,
                power_base_watts: 4000000000.0,
            )),
            resources: {},
        ),

        (
            id: "shield_geodesic_medium",
            name: "Geodesic Shield M",
            description: "Medium geodesic force field generator with extended projection range. The geodesic field tessellation provides complete spherical coverage — no blind spots, no gaps. Visible as a faint hexagonal shimmer when active. Requires fusion-class reactor power.",
            category: Interstellar,
            mass: 1000.0,
            cost: 5000000,
            size: XL,
            shape: Rectangle,
            grid_width: 13.0,
            grid_height: 11.0,
            shield: Some((
                shield_type: Geodesic,
                max_velocity_c: 0.85,
                power_base_watts: 8000000000.0,
            )),
            resources: {},
        ),

        (
            id: "shield_geodesic_large",
            name: "Geodesic Shield L",
            description: "Large geodesic force field generator for capital ships. Maximum standoff distance vaporizes debris before it can transfer momentum to the hull. At 0.85c, the field dissipates gigajoules per second of kinetic energy from interstellar hydrogen alone. Only antimatter reactors can sustain this power draw.",
            category: Interstellar,
            mass: 3000.0,
            cost: 12000000,
            size: XL,
            shape: Rectangle,
            grid_width: 17.0,
            grid_height: 13.0,
            shield: Some((
                shield_type: Geodesic,
                max_velocity_c: 0.85,
                power_base_watts: 16000000000.0,
            )),
            resources: {},
        ),
    ],
