// Radiator Definitions
// Twelve radiators across three tech tiers (Heat Pipe, Droplet, Phononic) × four sizes.
// All radiators are deployable wings — stowed during launch/burn, extended in vacuum.
// Heat rejection scales with deploy_fraction. Operating temperatures determine
// max_heat_tolerance — radiators survive their own design temp but no higher.
//
// Tier reference (from docs/part_ideas.md):
//   Heat Pipe Panel:        1,200 K,  216 kW/m²,  8 kg/m²  (fission era)
//   Liquid Metal Droplet:   2,500 K,  4.2 MW/m²,  3 kg/m²  (fusion era)
//   Phononic Metamaterial:  6,000 K,  145 MW/m²,  1.5 kg/m² (antimatter era)
//
// Mass and rejection wattage scale with effective deployed panel area. Stowed dimensions
// are 1 grid wide × {2,4,8,16} grid tall for Tiny/Small/Medium/Large.

(
    parts: [
        // ============================================
        // HEAT PIPE PANELS — Fission Era (1,200 K)
        // Sodium/lithium heat pipes in carbon-carbon composite sheets.
        // ============================================

        (
            id: "radiator_heatpipe_tiny",
            name: "Heat Pipe Panel T",
            description: "Sodium/lithium heat-pipe radiator panel for probe-scale fission reactors. Deploys to a thin 232 m² wing of carbon-carbon composite. Operating temperature 1,200 K — bright cherry red in vacuum.",
            category: Heat,
            mass: 1.85,
            cost: 8000,
            size: Tiny,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 2.0,
            radiator: Some((
                tier: HeatPipe,
                rejection_watts: 50000000.0,
                deploy_time_sec: 5.0,
            )),
            max_heat_tolerance: 1500.0,
            emissivity: 0.92,
            resources: {},
        ),

        (
            id: "radiator_heatpipe_small",
            name: "Heat Pipe Panel S",
            description: "Sodium/lithium heat-pipe radiator for crewed fission-era ships. 1,160 m² deployed area sheds a quarter gigawatt of reactor waste heat. Glows cherry red when working hard.",
            category: Heat,
            mass: 9.3,
            cost: 25000,
            size: Small,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 4.0,
            radiator: Some((
                tier: HeatPipe,
                rejection_watts: 250000000.0,
                deploy_time_sec: 5.0,
            )),
            max_heat_tolerance: 1500.0,
            emissivity: 0.92,
            resources: {},
        ),

        (
            id: "radiator_heatpipe_medium",
            name: "Heat Pipe Panel M",
            description: "Heavy heat-pipe radiator wing for Orion-class fission vessels. 4,600 m² of carbon-carbon panel rejecting 1 GW of waste heat. The defining silhouette of fission-era interstellar ships — long red-glowing wings extended in both directions.",
            category: Heat,
            mass: 37.0,
            cost: 80000,
            size: Medium,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 8.0,
            radiator: Some((
                tier: HeatPipe,
                rejection_watts: 1000000000.0,
                deploy_time_sec: 5.0,
            )),
            max_heat_tolerance: 1500.0,
            emissivity: 0.92,
            resources: {},
        ),

        (
            id: "radiator_heatpipe_large",
            name: "Heat Pipe Panel L",
            description: "Capital-class heat-pipe radiator wing. 18,500 m² of panel area rejects 4 gigawatts of fission waste heat — enough that an Orion + Fission Large only needs fifteen of these to stay cool. Mass dominated by the wing structure (148 t of carbon-carbon).",
            category: Heat,
            mass: 148.0,
            cost: 250000,
            size: Large,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 16.0,
            radiator: Some((
                tier: HeatPipe,
                rejection_watts: 4000000000.0,
                deploy_time_sec: 5.0,
            )),
            max_heat_tolerance: 1500.0,
            emissivity: 0.92,
            resources: {},
