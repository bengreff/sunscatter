        // ============================================
        // LIQUID METAL DROPLET RADIATORS — Fusion Era (2,500 K)
        // Tin/lithium droplets sprayed into vacuum, radiating freely,
        // magnetically recollected. No solid radiating surface.
        // ============================================

        (
            id: "radiator_droplet_tiny",
            name: "Droplet Radiator T",
            description: "Compact liquid-tin droplet radiator. Magnetic emitter sprays a curtain of molten metal droplets into vacuum where they radiate freely at 2,500 K, then a collector electrode recaptures them. No solid radiating surface means no melting-point limit — only the working fluid matters.",
            category: Heat,
            mass: 0.71,
            cost: 25000,
            size: Tiny,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 2.0,
