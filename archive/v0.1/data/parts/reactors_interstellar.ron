// Interstellar Reactor Definitions
// Six reactors across three technology tiers: Fission, Fusion, Antimatter.
// Constant power output — no fuel consumption (like RTGs but much higher output).
// Required for powering interstellar shields, radiators, and electric propulsion.
// Masses are reactor-only — radiators are separate ship parts.

(
    parts: [
        // ============================================
        // FISSION SMALL — Prometheus (500 MW)
        // ============================================

        (
            id: "reactor_fission_small",
            name: "Prometheus",
            description: "Heavy fission reactor for interstellar spacecraft. Gas-core design operates at extreme temperatures, converting nuclear heat to 500 megawatts of electrical power through MHD generators. Shadow-shielded to protect crew from neutron flux. The minimum power source for FRES shielding.",
            category: Electricity,
            mass: 125.0,
            cost: 500000,
            size: Medium,
            shape: Rectangle,
            grid_width: 5.0,
            grid_height: 7.0,
            reactor: Some((
                output_watts: 500000000.0,
                waste_heat_watts: 214000000.0, // 214 MW (30% of 714 MW reaction power)
            )),
            resources: {},
        ),

        // ============================================
        // FISSION LARGE — Vulcan (1.6 GW)
        // ============================================

        (
            id: "reactor_fission_large",
            name: "Vulcan",
            description: "Massive gas-core fission reactor producing 1.6 gigawatts. Rotating uranium plasma core achieves temperatures impossible in solid-core designs. Powers multiple FRES shield generators and heat-pipe radiator arrays simultaneously. The backbone of early interstellar power systems.",
            category: Electricity,
            mass: 400.0,
            cost: 1200000,
            size: Large,
            shape: Rectangle,
            grid_width: 9.0,
            grid_height: 9.0,
            reactor: Some((
                output_watts: 1600000000.0,
                waste_heat_watts: 686000000.0, // 686 MW (30% of 2.3 GW reaction power)
            )),
            resources: {},
        ),

        // ============================================
        // FUSION SMALL — Stellarator (10 GW)
        // ============================================

        (
            id: "reactor_fusion_small",
            name: "Stellarator",
            description: "Compact fusion power reactor using D+He3 fuel in a stellarator magnetic confinement geometry. Produces 10 gigawatts — enough to power a small interstellar vessel's shields, drives, and life support simultaneously. Negligible neutron flux from aneutronic fusion extends component lifetime.",
            category: Electricity,
            mass: 200.0,
            cost: 3000000,
            size: Large,
            shape: Rectangle,
            grid_width: 7.0,
            grid_height: 7.0,
            reactor: Some((
                output_watts: 10000000000.0,
                waste_heat_watts: 6700000000.0, // 6.7 GW (40% of 16.7 GW reaction power)
            )),
            resources: {},
        ),

        // ============================================
        // FUSION LARGE — Tokamak (30 GW)
        // ============================================

        (
            id: "reactor_fusion_large",
            name: "Tokamak",
            description: "Heavy fusion power reactor with a high-field tokamak geometry. 30 gigawatts of clean power from D+He3 fuel — enough for the largest crewed interstellar vessels with full geodesic shielding and droplet radiator arrays. The fusion era's equivalent of a nuclear aircraft carrier's power plant.",
            category: Electricity,
            mass: 600.0,
            cost: 8000000,
            size: XL,
            shape: Rectangle,
            grid_width: 11.0,
            grid_height: 9.0,
            reactor: Some((
                output_watts: 30000000000.0,
                waste_heat_watts: 20000000000.0, // 20 GW (40% of 50 GW reaction power)
            )),
            resources: {},
        ),

        // ============================================
        // ANTIMATTER SMALL — Penning Reactor (800 GW)
        // ============================================

        (
            id: "reactor_am_small",
            name: "Penning Reactor",
            description: "Antimatter power reactor using Penning trap confinement. Controlled proton-antiproton annihilation produces 800 gigawatts via direct charged-pion energy conversion. Antimatter consumption is measured in micrograms per hour. Compact enough for corvette-class vessels but powerful enough to run geodesic shields at relativistic speeds.",
            category: Electricity,
            mass: 400.0,
            cost: 20000000,
            size: Large,
            shape: Rectangle,
            grid_width: 7.0,
            grid_height: 7.0,
            reactor: Some((
                output_watts: 800000000000.0,
                waste_heat_watts: 141000000000.0, // 141 GW (15% of 941 GW reaction power)
                // ~37.6 g/hr antimatter + 37.6 g/hr LH2 = 75.2 g/hr total mass
                // flow, split 50/50.  Reactor produces no power if either fuel
                // runs out.
                fuel: Some((
                    primary: Antimatter,
                    secondary: Some(PureHydrogen),
                    secondary_fraction: 0.5,
                    total_kg_s: 0.0000209,
                )),
            )),
            resources: {},
        ),

        // ============================================
        // ANTIMATTER LARGE — Ixion Reactor (2.5 TW)
        // ============================================

        (
            id: "reactor_am_large",
            name: "Ixion Reactor",
            description: "The largest antimatter power reactor ever conceived. Multiple Penning trap arrays feed a cascade energy conversion system producing 2.5 terawatts — enough to power a capital ship's gamma-ray converter drive, geodesic shields, and phononic radiators simultaneously. At this power level, the reactor's own magnetic confinement field is visible as a faint blue glow.",
            category: Electricity,
            mass: 1250.0,
            cost: 50000000,
            size: XL,
            shape: Rectangle,
            grid_width: 11.0,
            grid_height: 9.0,
            reactor: Some((
                output_watts: 2500000000000.0,
                waste_heat_watts: 441000000000.0, // 441 GW (15% of 2.94 TW reaction power)
                // ~118 g/hr antimatter + 118 g/hr LH2 = 236 g/hr total mass
                // flow, split 50/50.  Reactor produces no power if either fuel
                // runs out.
                fuel: Some((
                    primary: Antimatter,
                    secondary: Some(PureHydrogen),
                    secondary_fraction: 0.5,
                    total_kg_s: 0.0000656,
                )),
            )),
            resources: {},
        ),
    ],
)
