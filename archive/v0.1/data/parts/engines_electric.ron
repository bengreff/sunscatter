// Electric Propulsion Engine Definitions
// EP engines accelerate propellant electromagnetically. Extreme Isp but very low thrust.
// Hard-require continuous electrical power — will not fire if insufficient power available.
// Three families: Ion (gridded electrostatic), Hall-effect, MPD (magnetoplasmadynamic)
// All use Xenon propellant from dedicated xenon tanks.

(
    parts: [
        // ============================================
        // ION ENGINES — Gridded Electrostatic
        // Highest Isp, lowest thrust. Deep space probes.
        // ============================================

        (
            id: "engine_ion_moth",
            name: "Moth",
            description: "Miniature gridded ion engine for deep space probes and asteroid rendezvous missions. Accelerates xenon ions through charged grids to achieve extraordinary exhaust velocity. Runs on solar power alone near Earth. Thrust measured in millinewtons.",
            category: Propulsion,
            mass: 0.012,
            cost: 4000,
            size: Tiny,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 2.0,
            hitbox_width: Some(1),
            flight_hitbox_width: Some(1.00),
            flight_hitbox_height: Some(2.00),
            hitbox_height: Some(2),
            engine: Some((
