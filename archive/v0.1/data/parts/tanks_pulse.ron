// Nuclear Pulse Magazine Definitions
// Shielded magazines for Orion-style fission pulse units.
// Each pulse unit is a shaped-charge fission device.
// Magazine structure is heavy radiation-shielded steel housing the
// pulse-unit feed system and explosive-decoupling hatches.
// Dimensions mirror the xenon tank lineup (Tiny/Small/Medium/Large).
// Fuel type is locked to NuclearPulse — these tanks cannot hold anything else.

(
    parts: [
        // ============================================
        // TINY PULSE MAGAZINE (1x1 grid)
        // ============================================

        (
            id: "tank_pulse_tiny",
            name: "PU-1",
            description: "Single-unit pulse magazine. A lead-shielded housing for one shaped-charge fission device, with an explosive ejection hatch on the underside. Useful for boost-only test articles or small Orion demonstrators.",
            category: FuelTanks,
            mass: 0.024,
            cost: 15000,
            size: Tiny,
            shape: Rectangle,
            grid_width: 1.0,
            grid_height: 1.0,
            tank: Some((
                grid_area: 0.4,
                fixed_fuel_type: Some(NuclearPulse),
            )),
            resources: {},
        ),

        // ============================================
