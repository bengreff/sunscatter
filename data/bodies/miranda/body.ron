// Miranda. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Miranda",
        radius_eq: 237279.7505,
        radius_polar: 232900.0,
        j2: 0.0,
        // IAU series with its periodic terms of at least 0.01 deg (4 of 18): within 1.5e-06 deg (pole) and 9.5e-15 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 257.43,
            dec_deg: -15.08,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 30.7,
            w_rate_deg_per_day: -254.6906892,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (102.23, -0.0554201232033, 4.41, 4.25, 1.15),
                (316.41, 0.0784109514031, 0.0, 0.0, -1.27),
                (632.82, 0.156821902806, 0.0, 0.0, 0.15),
                (204.46, -0.110840246407, -0.04, -0.02, -0.09),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (3730 m) plus 2 km, rounded up.
        rails_floor: 6000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets miranda` (range -8004 .. 3730 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 11 octaves reach ~1.4 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 11,
            wavelength: 1455.9,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            // No ridged octaves: crater walls, not mountain crests, make this roughness (they made jagged teeth).
            ridge_threshold: 1.0e9,
            // Crater-shaped detail (sim::terrain::craters): 5 octaves of cells from the map spacing
            // down to 91 m, 25% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/technical/solar-visuals.md).
            craters: Some((octaves: 5, density: 0.25, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
