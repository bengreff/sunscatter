// Oberon's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: geometric albedo (JPL Horizons) standing in for the Bond albedo.
(
    base_color: (0.55, 0.52, 0.50),
    albedo: 0.24,
    roughness: 0.95,
    icon_color: (0.72, 0.69, 0.68),
    // Procedural surface (no global map exists; docs/technical/solar-visuals.md): relief and colour
    // baked by `asset-tool planets` from measured statistics. Zone albedo: linear reflectance at
    // ~645, 555, 470 nm from the geometric albedo 0.31 (Karkoschka 2001); slightly red;
    // colour indices converted with the Sun's B-V 0.653, V-R 0.356. Fresh ejecta: 1.6x (assumed).
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.0,
        list: [
            (name: "terrain", source: (188, 185, 181), albedo: Some((0.320, 0.310, 0.297)),
                pattern: (scale_m: 1000.0, contrast: 0.12)),
            (name: "fresh ejecta", source: (232, 228, 223), albedo: Some((0.512, 0.496, 0.475)),
                pattern: (scale_m: 600.0, contrast: 0.08)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        rock_color: (0.256, 0.248, 0.237),
    )),
)
