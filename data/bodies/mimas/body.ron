// Mimas. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Mimas",
        radius_eq: 202173.8361,
        radius_polar: 190600.0,
        j2: 0.0,
        // IAU series with its periodic terms of at least 0.01 deg (2 of 8): within 8.5e-07 deg (pole) and 0 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 40.66,
            dec_deg: 83.52,
            ra_rate_deg_per_century: -0.036,
            dec_rate_deg_per_century: -0.004,
            w0_deg: 333.46,
            w_rate_deg_per_day: 381.994555,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (316.45, 0.0138590006845, 0.0, 0.0, -44.85),
                (177.4, -0.999466119097, 13.56, -1.53, -13.48),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (9041 m) plus 2 km, rounded up.
        rails_floor: 12000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): IAU Gazetteer craters at their positions, a crater population from the measured density, triaxial shape, regional fBm
        // Baked by `asset-tool planets mimas` (range -15596 .. 9041 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 10 octaves reach ~2.4 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 10,
            wavelength: 1240.5,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            // No ridged octaves: crater walls, not mountain crests, make this roughness (they made jagged teeth).
            ridge_threshold: 1.0e9,
            // Crater-shaped detail (sim::terrain::craters): 5 octaves of cells from the map spacing
            // down to 78 m, 50% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 5, density: 0.5, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
