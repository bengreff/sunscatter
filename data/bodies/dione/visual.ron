// Dione's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: Bond albedo ~0.63 (Howett et al. 2010).
(
    base_color: (0.78, 0.78, 0.77),
    albedo: 0.63,
    roughness: 0.95,
    icon_color: (0.91, 0.91, 0.90),
    // Zones (crisp-surfaces.md) from k-means centres of the colour map (Cassini-Voyager mosaic 154 m, USGS) in CIELAB;
    // `albedo`: linear reflectance (~645, 555, 470 nm): the body's mean albedo 0.63 (Bond, Howett et al. 2010) times
    // the zone's brightness ratio in the map^0.5 (mosaics are display-stretched), coloured by B-V 0.71, V-R 0.38.
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.3,
        list: [
            (name: "wispy dark terrain", source: (75, 75, 75), albedo: Some((0.372, 0.364, 0.345)),
                pattern: (scale_m: 1500.0, contrast: 0.1)),
            (name: "cratered plains", source: (111, 111, 111), albedo: Some((0.558, 0.545, 0.518)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright plains", source: (139, 139, 139), albedo: Some((0.708, 0.693, 0.658)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright ejecta", source: (180, 180, 180), albedo: Some((0.943, 0.922, 0.875)),
                pattern: (scale_m: 600.0, contrast: 0.1)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        // Airless: keep detail out to 40 km (as the Moon).
        fade_m: Some(40000.0),
        rock_color: (0.30, 0.30, 0.29),
    )),
)
