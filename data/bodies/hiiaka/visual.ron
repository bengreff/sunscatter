// Hi'iaka's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: unmeasured; an icy surface assumed.
(
    base_color: (0.80, 0.80, 0.80),
    albedo: 0.4,
    roughness: 0.95,
    icon_color: (0.93, 0.93, 0.93),
    // Procedural surface (no global map exists; docs/features/solar-visuals.md): relief and colour
    // baked by `asset-tool planets` from measured statistics. Zone albedo: linear reflectance at
    // ~645, 555, 470 nm from the albedo unmeasured: ~0.8 assumed for its crystalline water-ice spectrum (Barkume et al. 2006); neutral;
    // colour indices converted with the Sun's B-V 0.653, V-R 0.356. Fresh ejecta: 1.6x (assumed).
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.0,
        list: [
            (name: "terrain", source: (188, 187, 187), albedo: Some((0.803, 0.800, 0.802)),
                pattern: (scale_m: 1000.0, contrast: 0.12)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        // Airless: keep detail out to 40 km (as the Moon).
        fade_m: Some(40000.0),
        rock_color: (0.642, 0.640, 0.642),
    )),
)
