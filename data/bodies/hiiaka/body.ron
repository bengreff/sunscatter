// Hi'iaka. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radius: ~160 km (JPL).
// GM and orbit: JPL Horizons TNO satellite solutions (2022) and small-body solutions.
(
    physical: (
        name: "Hi'iaka",
        radius_eq: 160000.0,
        radius_polar: 160000.0,
        j2: 0.0,
        // Placeholder pole (its orbit normal); spin ~9.8 h (JPL).
        rotation: (
            ra_deg: 112.006654,
            dec_deg: -14.573021,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 881.632653061,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): no terrain yet, so the margin above the ellipsoid.
        rails_floor: 2000.0,
        heightmap: None,
        sea_level: None,
    ),
)
