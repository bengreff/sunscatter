// Ariel. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Ariel",
        radius_eq: 579497.7912,
        radius_polar: 577700.0,
        j2: 0.0,
        // IAU series with its periodic terms of at least 0.01 deg (2 of 13): within 1.5e-06 deg (pole) and 0 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 257.43,
            dec_deg: -15.1,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 156.22,
            w_rate_deg_per_day: -142.8356681,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (304.01, -0.00142203969884, 0.29, 0.28, 0.08),
                (316.41, 0.0784109514031, 0.0, 0.0, 0.05),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (3686 m) plus 2 km, rounded up.
        rails_floor: 6000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets ariel` (range -6300 .. 3686 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~1.7 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 3555.8,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
