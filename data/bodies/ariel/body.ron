// Ariel. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Ariel",
        radius_eq: 579497.7912,
        radius_polar: 577700.0,
        j2: 0.0,
        // IAU pole with its periodic terms linearised about 2055: within 0.0072 deg of the full series over 2030-2080; prime meridian without its periodic terms
        rotation: (
            ra_deg: 257.1550228,
            dec_deg: -14.93446525,
            ra_rate_deg_per_century: -0.02493673491,
            dec_rate_deg_per_century: -0.2526822335,
            w0_deg: 156.22,
            w_rate_deg_per_day: -142.8356681,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): no terrain yet, so the margin above the ellipsoid.
        rails_floor: 2000.0,
        heightmap: None,
        sea_level: None,
    ),
)
