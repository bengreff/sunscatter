// Enceladus. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2: Cassini, Iess et al. 2014, Science 344, 78 (5,435.2e-6 at 254.2 km), rescaled.
(
    physical: (
        name: "Enceladus",
        radius_eq: 253986.6926,
        radius_polar: 248300.0,
        j2: 0.00544376274,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 40.66,
            dec_deg: 83.52,
            ra_rate_deg_per_century: -0.036,
            dec_rate_deg_per_century: -0.004,
            w0_deg: 6.32,
            w_rate_deg_per_day: 262.7318996,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (3154 m) plus 2 km, rounded up.
        rails_floor: 6000.0,
        // Terrain heights (m) above the reference spheroid, 720×360: Cassini ISS shape model (Bland et al. 2020; USGS, 2 ppd), via asset-tool planets
        // Baked by `asset-tool planets enceladus` (range -3535 .. 3154 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 11 octaves reach ~2.2 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 11,
            wavelength: 2216.5,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
            // Crater-shaped detail (sim::terrain::craters): 5 octaves of cells from the map spacing
            // down to 139 m, 20% of them holding a bowl 0.12 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 5, density: 0.2, depth_ratio: 0.12)),
        )),
        sea_level: None,
    ),
)
