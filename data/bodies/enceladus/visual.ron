// Enceladus's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: Bond albedo 0.81 (Howett et al. 2010).
(
    base_color: (0.95, 0.95, 0.96),
    albedo: 0.81,
    roughness: 0.95,
    icon_color: (1.00, 1.00, 1.00),
    // Zones (crisp-surfaces.md) from k-means centres of the colour map (Cassini ISS mosaic 110 m, USGS) in CIELAB;
    // `albedo`: linear reflectance (~645, 555, 470 nm): the body's mean albedo 0.81 (Bond, Howett et al. 2010) times
    // the zone's brightness ratio in the map^0.5 (mosaics are display-stretched), coloured by B-V 0.62, V-R 0.32.
    // Zones (crisp-surfaces.md) from k-means centres of the colour map (Cassini ISS mosaic 110 m, USGS) in CIELAB;
    // `albedo`: linear reflectance (~645, 555, 470 nm): the body's mean albedo 0.81 (Bond, Howett et al. 2010) times
    // the zone's brightness ratio in the map^0.5 (mosaics are display-stretched), coloured by B-V 0.62, V-R 0.32.
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.3,
        list: [
            (name: "cratered terrain", source: (72, 72, 72), albedo: Some((0.530, 0.547, 0.564)),
                pattern: (scale_m: 1500.0, contrast: 0.1)),
            (name: "plains", source: (103, 103, 103), albedo: Some((0.767, 0.793, 0.818)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright plains", source: (137, 137, 137), albedo: Some((0.950, 0.950, 0.950)),
                pattern: (scale_m: 600.0, contrast: 0.1)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        // Airless: keep detail out to 40 km (as the Moon).
        fade_m: Some(40000.0),
        rock_color: (0.30, 0.30, 0.29),
    )),
)
