// Saturn. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// J2: Cassini Grand Finale, Iess et al. 2019, Science 364 (16,290.573e-6 at R = 60,330 km, rescaled to 60,268 km). No surface: 1-bar ellipsoid.
(
    physical: (
        name: "Saturn",
        radius_eq: 60268000.0,
        radius_polar: 54364000.0,
        j2: 0.01632410771,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 40.589,
            dec_deg: 83.537,
            ra_rate_deg_per_century: -0.036,
            dec_rate_deg_per_century: -0.004,
            w0_deg: 38.9,
            w_rate_deg_per_day: 810.7939024,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: false,
        rails_floor: 0.0,
        heightmap: None,
        sea_level: None,
    ),
)
