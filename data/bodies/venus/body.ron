// Venus. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// J2: NASA Planetary Fact Sheet (NSSDCA, Williams).
(
    physical: (
        name: "Venus",
        radius_eq: 6051800.0,
        radius_polar: 6051800.0,
        j2: 4.458e-06,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 272.76,
            dec_deg: 67.16,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 160.2,
            w_rate_deg_per_day: -1.4813688,
        ),
        atmosphere: Some((
            // Skeleton (solar-system.md). 0-65 km: the Venus International Reference
            // Atmosphere (Seiff et al. 1985, Adv. Space Res. 5(11)), temperature and
            // pressure (bar) as reproduced in Wikipedia's "Atmosphere of Venus", density
            // from the ideal gas (65.5 kg/m3 at the surface). Above: hydrostatic (g falling
            // with height) through temperatures from the same article: 230 K at 73 km
            // (Patzold et al. 2007), 165 K at the mesopause at 95 km, held to 110 km, then
            // rising to 200 K by 130 km, a day-night mean of the thermosphere (300-400 K
            // by day, ~100 K at night, Bertaux et al. 2007), constant above; CO2/N2 mean
            // molar mass throughout (the thermosphere's atomic oxygen is left out). The
            // table runs up to where the density is negligible (~1e-14 kg/m3), so drag
            // meets no wall; `top` (live flight, the rails floor) is where the density
            // falls to ~2e-9 kg/m3, like Earth's 150 km. 96.5 % CO2, 3.5 % N2 (M = 43.45
            // g/mol); gamma 1.29; VHS collision diameter of CO2 (Bird 1994); Sutton-Graves
            // for 96.5 % CO2, 3.5 % N2 by their mixing rule (TR R-376 eq. 44; aero::gas); no
            // radiative heating relation.
            top: 150000.0, gamma: 1.29, collision_diameter: 5.62e-10, sutton_graves_k: 1.8967e-4,
            gas: CarbonDioxide,
