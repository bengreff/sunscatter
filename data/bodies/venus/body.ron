// Venus. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// J2: NASA Planetary Fact Sheet (NSSDCA, Williams).
(
    physical: (
        name: "Venus",
        radius_eq: 6051800.0,
        radius_polar: 6051800.0,
        j2: 4.458e-06,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 272.76,
            dec_deg: 67.16,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 160.2,
            w_rate_deg_per_day: -1.4813688,
        ),
        atmosphere: Some((
            // Skeleton (solar-system.md). 0-65 km: the Venus International Reference
            // Atmosphere (Seiff et al. 1985, Adv. Space Res. 5(11)), temperature and
            // pressure (bar) as reproduced in Wikipedia's "Atmosphere of Venus",
            // density from the ideal gas (65.5 kg/m3 at the surface; NASA's fact sheet
            // gives ~65). Above 65 km: isothermal at 243 K and hydrostatic (H = 5.25 km,
            // g = 8.87): our assumption, ~3x VIRA's density at 100 km and far above the
            // real thermosphere's beyond 120 km (VIRA's upper tables, Keating et al. 1985,
            // not yet transcribed). 96.5 % CO2, 3.5 % N2 (M = 43.45 g/mol); gamma 1.29;
            // VHS collision diameter of CO2 (Bird 1994); Sutton-Graves for CO2/N2 (the
            // Mars constant); no radiative heating relation.
            top: 140000.0, gamma: 1.29, collision_diameter: 5.62e-10, sutton_graves_k: 1.9027e-4,
