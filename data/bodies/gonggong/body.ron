// Gonggong. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radius: 615 +- 25 km (Kiss et al. 2019).
// Orbit: JPL Horizons small-body solution; GM in sol-systems.ron.
(
    physical: (
        name: "Gonggong",
        radius_eq: 615000.0,
        radius_polar: 615000.0,
        j2: 0.0,
        // Pole unknown: placeholder at the ecliptic north pole; spin 22.40 h (Kiss et al. 2019).
        rotation: (
            ra_deg: 270.0,
            dec_deg: 66.560708,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 385.714285714,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): no terrain yet, so the margin above the ellipsoid.
        rails_floor: 2000.0,
        heightmap: None,
        sea_level: None,
    ),
)
