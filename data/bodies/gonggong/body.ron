// Gonggong. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radius: 615 +- 25 km (Kiss et al. 2019).
// Orbit: JPL Horizons small-body solution; GM in sol-systems.ron.
(
    physical: (
        name: "Gonggong",
        radius_eq: 615000.0,
        radius_polar: 615000.0,
        j2: 0.0,
        // Pole unknown: placeholder at the ecliptic north pole; spin 22.40 h (Kiss et al. 2019).
        rotation: (
            ra_deg: 270.0,
            dec_deg: 66.560708,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 385.714285714,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (2732 m) plus 2 km, rounded up.
        rails_floor: 5000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets gonggong` (range -5405 .. 2732 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~1.8 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 3773.6,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            // No ridged octaves: crater walls, not mountain crests, make this roughness (they made jagged teeth).
            ridge_threshold: 1.0e9,
            // Crater-shaped detail (sim::terrain::craters): 6 octaves of cells from the map spacing
            // down to 118 m, 20% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/technical/solar-visuals.md).
            craters: Some((octaves: 6, density: 0.2, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
