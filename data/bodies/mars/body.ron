// Mars. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// J2: NASA Planetary Fact Sheet (NSSDCA, Williams). To the ephemeris Mars is still its system (Phobos and Deimos not modelled).
(
    physical: (
        name: "Mars",
        radius_eq: 3396190.0,
        radius_polar: 3376200.0,
        j2: 0.00196045,
        // IAU series with its periodic terms of at least 0.01 deg (3 of 26): within 0.00021 deg (pole) and 0.00027 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 317.269202,
            dec_deg: 54.432516,
            ra_rate_deg_per_century: -0.10927547,
            dec_rate_deg_per_century: -0.05827105,
            w0_deg: 176.049863,
            w_rate_deg_per_day: 350.891982443,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (166.325722, 1.3805927447e-05, 0.0, 1.591274, 0.0),
                (95.391654, 1.3805927447e-05, 0.0, 0.0, 0.584542),
                (79.398797, 1.3805927447e-05, 0.419057, 0.0, 0.0),
            ],
        ),
        atmosphere: Some((
            // Skeleton (solar-system.md). 0-40 km: NASA Glenn Research Center's Mars
            // model (T = -31 - 0.000998 h below 7 km, -23.4 - 0.00222 h above, deg C;
            // p = 0.699 exp(-0.00009 h) kPa; rho = p / (0.1921 (T + 273.1))), a fit to
            // Mars Global Surveyor data. Above 40 km: hydrostatic at the 40 km temperature
            // (161 K, g falling with height): our assumption, within a few times of
            // aerobraking densities near 100-120 km (the real upper atmosphere varies
            // tenfold with season and dust). The table runs up to where the density is
            // negligible (~1e-14 kg/m3), so drag meets no wall; `top` (live flight, the
            // rails floor) is where it falls to ~2e-9 kg/m3, like Earth's 150 km. CO2
            // (M = 43.34 g/mol, 95 %), gamma 1.29; VHS collision diameter of CO2 (Bird
            // 1994); Sutton-Graves and Tauber-Sutton for Mars.
            top: 150000.0, gamma: 1.29, collision_diameter: 5.62e-10, sutton_graves_k: 1.9027e-4,
            gas: CarbonDioxide,
            radiative_heating: Some(Mars),
            // (altitude m, temperature K, pressure Pa, density kg/m3, mean molar mass kg/mol)
            table: Some([
                (0.0, 242.150, 6.99000e+02, 1.50299e-02, 0.04334),
                (2000.0, 240.154, 5.83854e+02, 1.26584e-02, 0.04334),
