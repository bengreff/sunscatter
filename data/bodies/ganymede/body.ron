// Ganymede. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radius: IAU mean radius (a sphere).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2: Galileo, Schubert et al. 2004 (table 13.1: 127.53e-6 at 2,634.1 km), rescaled.
(
    physical: (
        name: "Ganymede",
        radius_eq: 2631200.0,
        radius_polar: 2631200.0,
        j2: 0.0001278112715,
        // IAU series with its periodic terms of at least 0.01 deg (3 of 6): within 8.5e-07 deg (pole) and 5.6e-17 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 268.2,
            dec_deg: 64.57,
            ra_rate_deg_per_century: -0.009,
            dec_rate_deg_per_century: 0.003,
            w0_deg: 44.064,
            w_rate_deg_per_day: 50.3176081,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (119.9, 0.00717590691307, 0.431, 0.186, -0.389),
                (229.8, 0.00176043805613, 0.091, 0.039, -0.082),
                (355.8, 0.0326160164271, -0.037, -0.016, 0.033),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (1876 m) plus 2 km, rounded up.
        rails_floor: 4000.0,
        // Terrain heights (m) above the reference spheroid, 2048×1024: procedural relief (no global DEM): IAU Gazetteer craters at their positions, a crater population from the measured density, regional fBm
        // Baked by `asset-tool planets ganymede` (range -3132 .. 1876 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 13 octaves reach ~2.0 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 13,
            wavelength: 8072.4,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
