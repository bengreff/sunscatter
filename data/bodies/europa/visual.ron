// Europa's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: geometric albedo (JPL Horizons) standing in for the Bond albedo.
(
    base_color: (0.86, 0.81, 0.73),
    albedo: 0.67,
    roughness: 0.95,
    icon_color: (0.98, 0.94, 0.87),
    // Zones (crisp-surfaces.md) from k-means centres of the colour map (Voyager-Galileo SSI mosaic 500 m, USGS) in CIELAB;
    // `albedo`: linear reflectance (~645, 555, 470 nm): the body's mean albedo 0.67 (geometric, JPL) times
    // the zone's brightness ratio in the map^0.5 (mosaics are display-stretched); colours from Galileo SSI:
    // near-neutral ice plains, reddish-brown lineae and chaos (McEwen 1986, JGR 91, 8077; Carlson et al. 2009).
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.3,
        list: [
            (name: "lineae and chaos", source: (115, 115, 115), albedo: Some((0.500, 0.420, 0.320)),
                pattern: (scale_m: 1500.0, contrast: 0.1)),
            (name: "ridged plains", source: (139, 139, 139), albedo: Some((0.680, 0.640, 0.570)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright plains", source: (160, 160, 160), albedo: Some((0.780, 0.750, 0.690)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright ejecta", source: (179, 179, 179), albedo: Some((0.880, 0.860, 0.820)),
                pattern: (scale_m: 600.0, contrast: 0.1)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        rock_color: (0.30, 0.30, 0.29),
    )),
)
