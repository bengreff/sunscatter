// Europa. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2: Galileo, Schubert et al. 2004 (table 13.1: 435.5e-6 at 1,565 km), rescaled.
(
    physical: (
        name: "Europa",
        radius_eq: 1561449.577,
        radius_polar: 1559500.0,
        j2: 0.0004375105128,
        // IAU series with its periodic terms of at least 0.01 deg (3 of 7): within 0.0039 deg (pole) and 0.008 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 268.08,
            dec_deg: 64.51,
            ra_rate_deg_per_century: -0.009,
            dec_rate_deg_per_century: 0.003,
            w0_deg: 36.022,
            w_rate_deg_per_day: 101.3747235,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (355.8, 0.0326160164271, 1.086, 0.468, -0.98),
                (119.9, 0.00717590691307, 0.06, 0.026, -0.054),
                (229.8, 0.00176043805613, 0.015, 0.007, -0.014),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (1386 m) plus 2 km, rounded up.
        rails_floor: 4000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): IAU Gazetteer craters at their positions, a crater population from the measured density, regional fBm
        // Baked by `asset-tool planets europa` (range -1935 .. 1386 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 13 octaves reach ~2.3 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 13,
            wavelength: 9580.9,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            // No ridged octaves: crater walls, not mountain crests, make this roughness (they made jagged teeth).
            ridge_threshold: 1.0e9,
            // Crater-shaped detail (sim::terrain::craters): 8 octaves of cells from the map spacing
            // down to 75 m, 2% of them holding a bowl 0.1 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 8, density: 0.02, depth_ratio: 0.1)),
        )),
        sea_level: None,
    ),
)
