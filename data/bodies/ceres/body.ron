// Ceres. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 left out for now (Dawn measured it; Park et al. 2016).
(
    physical: (
        name: "Ceres",
        radius_eq: 487300.0,
        radius_polar: 446000.0,
        j2: 0.0,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 291.418,
            dec_deg: 66.764,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 170.65,
            w_rate_deg_per_day: 952.1532,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (9405 m) plus 2 km, rounded up.
        rails_floor: 12000.0,
        // Terrain heights (m) above the reference spheroid, 2048×1024: Dawn FC HAMO DTM (Preusker et al. 2016; DLR, 60 ppd), via asset-tool planets
        // Baked by `asset-tool planets ceres` (range -12493 .. 9405 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 11 octaves reach ~1.5 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 11,
            wavelength: 1495.0,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
