// Iapetus. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Iapetus",
        radius_eq: 745700.0,
        radius_polar: 712100.0,
        j2: 0.0,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 318.16,
            dec_deg: 75.03,
            ra_rate_deg_per_century: -3.949,
            dec_rate_deg_per_century: -1.143,
            w0_deg: 355.2,
            w_rate_deg_per_day: 4.5379572,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (5468 m) plus 2 km, rounded up.
        rails_floor: 8000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): IAU Gazetteer craters at their positions, a crater population from the measured density, regional fBm (the equatorial ridge is not modelled)
        // Baked by `asset-tool planets iapetus` (range -14278 .. 5468 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~2.2 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 4575.6,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
            // Crater-shaped detail (sim::terrain::craters): 7 octaves of cells from the map spacing
            // down to 71 m, 50% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 7, density: 0.5, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
