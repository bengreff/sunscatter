// Earth's visuals (read by crates/game; physical data is in body.ron).
(
    base_color: (0.18, 0.32, 0.55),
    color_map: Some("color.jpg"),
    albedo: 0.30,
    roughness: 0.85,
    icon_color: (0.45, 0.65, 1.0),
    // Open ocean's water-leaving reflectance (π·Rrs for clear water: ~0.03 at
    // 443 nm, ~0.008 at 555 nm, ~0.003 at 670 nm).
    ocean: Some((
        roughness: 0.12,
        albedo: (0.003, 0.008, 0.03),
        mask: Some("water.png"),
    )),
    // Land zones (crisp-surfaces.md), baked into zones.png by
    // `asset-tool zones`. Sources are cluster centres of the Blue Marble
    // land pixels (k-means in CIELAB, 2026-10-25); each zone is drawn in
    // its source colour (the map's own reflectance) with a procedural
    // pattern. No constraints are needed: everything the ice zone takes
    // below 55° latitude is a real glacier (Patagonia, Kerguelen, South
    // Georgia, high mountains), and salt pans are nearer "pale ground".
    zones: Some((
        map: "zones.png",
        tint: 0.3,
        list: [
            (name: "ice", source: (237, 239, 240), pattern: (scale_m: 3000.0, contrast: 0.05)),
            (name: "dark forest", source: (20, 24, 9), pattern: (scale_m: 600.0, contrast: 0.25)),
            (name: "forest", source: (31, 43, 15), pattern: (scale_m: 800.0, contrast: 0.25)),
            (name: "woodland", source: (61, 62, 31), pattern: (scale_m: 1000.0, contrast: 0.25)),
            (name: "scrub", source: (100, 85, 55), pattern: (scale_m: 1200.0, contrast: 0.2)),
            (name: "red earth", source: (116, 74, 42), pattern: (scale_m: 2000.0, contrast: 0.15)),
            (name: "steppe", source: (137, 119, 88), pattern: (scale_m: 1500.0, contrast: 0.15)),
            (name: "desert", source: (185, 156, 117), pattern: (scale_m: 2500.0, contrast: 0.12)),
            (name: "tundra", source: (98, 98, 83), pattern: (scale_m: 1000.0, contrast: 0.2)),
            (name: "bare rock", source: (150, 148, 138), pattern: (scale_m: 700.0, contrast: 0.25)),
            // Salt pans and ground with patchy snow.
            (name: "pale ground", source: (209, 213, 215), pattern: (scale_m: 1500.0, contrast: 0.15)),
            // Lakes above sea level and inland seas (the Caspian), which the
            // sea mask does not hold: near-black in the map.
            (name: "lake", source: (3, 6, 8), water: true),
        ],
    )),
    detail: Some((
        scale_m: 40.0,
        strength: 0.5,
        rock_color: (0.32, 0.30, 0.27),
        snow_line_m: Some(4500.0),
    )),
    // Hillaire 2020 / Bruneton Earth values; scale heights 8 km (Rayleigh)
    // and 1.2 km (Mie), ozone layer centred at 25 km.
    atmosphere: Some((
        thickness_m: 100000.0,
        rayleigh_scattering: (5.802e-6, 13.558e-6, 33.100e-6),
        rayleigh_scale_height_m: 8000.0,
        mie_scattering: (3.996e-6, 3.996e-6, 3.996e-6),
        mie_absorption: (0.444e-6, 0.444e-6, 0.444e-6),
        mie_scale_height_m: 1200.0,
        mie_asymmetry: 0.8,
        ozone: Some((absorption: (0.650e-6, 1.881e-6, 0.085e-6), center_m: 25000.0, width_m: 30000.0)),
        ground_albedo: (0.3, 0.3, 0.3),
    )),
)
