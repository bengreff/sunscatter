// Earth's visuals (read by crates/game; physical data is in body.ron).
(
    base_color: (0.18, 0.32, 0.55),
    color_map: Some("color.jpg"),
    albedo: 0.30,
    roughness: 0.85,
    icon_color: (0.45, 0.65, 1.0),
    // Open ocean's water-leaving reflectance (π·Rrs for clear water: ~0.03 at
    // 443 nm, ~0.008 at 555 nm, ~0.003 at 670 nm).
    ocean: Some((
        roughness: 0.12,
        albedo: (0.003, 0.008, 0.03),
        mask: Some("water.png"),
        // Over a bright sandy bottom the water-leaving reflectance rises
        // towards ~0.02, 0.09, 0.07 (π·Rrs over the Bahamas Banks at a few
        // metres), fading with depth over ~10 m (two-flow model, clear
        // tropical water: 1/(2·Kd) with Kd ≈ 0.05 /m): albedo +
        // (shallow − albedo)·exp(−depth / shallow_depth_m).
        shallow_albedo: Some((0.02, 0.09, 0.07)),
        shallow_depth_m: Some(10.0),
    )),
    // Land zones (crisp-surfaces.md), baked into zones.png by
    // `asset-tool zones`. `source`: the zone's colour in Blue Marble (sRGB),
    // cluster centres of its land pixels (k-means in CIELAB, 2026-10-25);
    // it classifies and gives the regional tint (`tint`), but Blue Marble is
    // a display stretch, not reflectance. `albedo`: what is drawn, the zone's
    // reflectance, LINEAR, for roughly the red, green and blue bands (MODIS
    // bands 1, 4, 3: ~645, 555, 470 nm), representative values within the
    // published ranges cited per zone (crisp-surfaces.md has the table).
    // No constraints are needed: everything the ice zone takes below 55°
    // latitude is a real glacier, and salt pans are nearer "pale ground".
    zones: Some((
        map: "zones.png",
        tint: 0.3,
        list: [
            // Antarctic/Greenland snow: 0.96-0.98 across the visible
            // (Grenfell, Warren & Mullen 1994, JGR 99(D9) 18669).
            (name: "ice", source: (237, 239, 240), albedo: Some((0.96, 0.97, 0.98)),
                pattern: (scale_m: 3000.0, contrast: 0.05)),
            // Dense evergreen (tropical, boreal) canopy: MODIS dark dense
            // vegetation, rho(470) ~ rho(2.1)/4, rho(660) ~ rho(2.1)/2 with
            // rho(2.1) 0.05-0.1 (Kaufman et al. 1997, IEEE TGRS 35, 1286);
            // closed-canopy green peak ~1.5-2x red. Visible albedo of
            // evergreen forests 0.03-0.04 (MODIS MCD43, Gao et al. 2005,
            // JGR 110 D01104).
            (name: "dark forest", source: (20, 24, 9), albedo: Some((0.025, 0.040, 0.018)),
                pattern: (scale_m: 600.0, contrast: 0.25)),
            // Forest (broadleaf, mixed): as above, visible albedo 0.04-0.05
            // (Gao et al. 2005).
            (name: "forest", source: (31, 43, 15), albedo: Some((0.035, 0.055, 0.025)),
                pattern: (scale_m: 800.0, contrast: 0.25)),
            // Woodland, croplands, woody savanna: visible albedo 0.05-0.07
            // (Gao et al. 2005).
            (name: "woodland", source: (61, 62, 31), albedo: Some((0.055, 0.070, 0.035)),
                pattern: (scale_m: 1000.0, contrast: 0.25)),
            // Open shrubland, dry savanna: visible albedo 0.08-0.12 (Gao et
            // al. 2005), soil showing through (red above green above blue).
            (name: "scrub", source: (100, 85, 55), albedo: Some((0.12, 0.10, 0.06)),
                pattern: (scale_m: 1200.0, contrast: 0.2)),
            // Iron-rich red sands and soils (central Australia, Kalahari):
            // steep red slope of hematite/goethite soils, red ~0.2-0.3, blue
            // under 0.1 (MODIS band albedos over arid soils, Tsvetsinskaya et
            // al. 2002, GRL 29(9) 1353).
            (name: "red earth", source: (116, 74, 42), albedo: Some((0.20, 0.11, 0.06)),
                pattern: (scale_m: 2000.0, contrast: 0.15)),
            // Steppe, dry grassland: visible albedo 0.1-0.15 (Gao et al. 2005).
            (name: "steppe", source: (137, 119, 88), albedo: Some((0.18, 0.15, 0.10)),
                pattern: (scale_m: 1500.0, contrast: 0.15)),
            // Sand seas of the Sahara and Arabia: MODIS white-sky albedo ~0.4
            // red, ~0.3 green, ~0.2 blue (Tsvetsinskaya et al. 2002).
            (name: "desert", source: (185, 156, 117), albedo: Some((0.40, 0.30, 0.20)),
                pattern: (scale_m: 2500.0, contrast: 0.12)),
            // Sparse tundra and cold high plateaus (lichen, moss, rock, the
            // Tibetan plateau): grey, between open shrubland and barren,
            // visible ~0.1 (Gao et al. 2005).
            (name: "tundra", source: (98, 98, 83), albedo: Some((0.11, 0.11, 0.09)),
                pattern: (scale_m: 1000.0, contrast: 0.2)),
            // Bare mountain rock, sparse cover: barren/sparsely vegetated
            // outside the sand seas, 0.15-0.2 (Gao et al. 2005).
            (name: "bare rock", source: (150, 148, 138), albedo: Some((0.18, 0.17, 0.15)),
                pattern: (scale_m: 700.0, contrast: 0.25)),
            // Salt pans and ground with patchy snow: Salar de Uyuni, a
            // calibration site, ~0.7-0.8 across the visible (Lamparelli et
            // al. 2003, IEEE TGRS 41(6) 1461).
            (name: "pale ground", source: (209, 213, 215), albedo: Some((0.70, 0.72, 0.72)),
                pattern: (scale_m: 1500.0, contrast: 0.15)),
            // Lakes above sea level and inland seas (the Caspian), which the
            // sea mask does not hold: near-black in the map. Drawn with the
            // open-water albedo above.
            (name: "lake", source: (3, 6, 8), water: true),
        ],
    )),
    detail: Some((
        scale_m: 40.0,
        strength: 0.5,
        rock_color: (0.32, 0.30, 0.27),
        snow_line_m: Some(4500.0),
    )),
    // Hillaire 2020 / Bruneton Earth values; scale heights 8 km (Rayleigh)
    // and 1.2 km (Mie), ozone layer centred at 25 km.
    atmosphere: Some((
        thickness_m: 100000.0,
        rayleigh_scattering: (5.802e-6, 13.558e-6, 33.100e-6),
        rayleigh_scale_height_m: 8000.0,
        mie_scattering: (3.996e-6, 3.996e-6, 3.996e-6),
        mie_absorption: (0.444e-6, 0.444e-6, 0.444e-6),
        mie_scale_height_m: 1200.0,
        mie_asymmetry: 0.8,
        ozone: Some((absorption: (0.650e-6, 1.881e-6, 0.085e-6), center_m: 25000.0, width_m: 30000.0)),
        ground_albedo: (0.3, 0.3, 0.3),
    )),
)
