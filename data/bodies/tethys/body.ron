// Tethys. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Tethys",
        radius_eq: 533326.0916,
        radius_polar: 526300.0,
        j2: 0.0,
        // IAU series with its periodic terms of at least 0.01 deg (2 of 8): within 8.5e-07 deg (pole) and 0 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 40.66,
            dec_deg: 83.52,
            ra_rate_deg_per_century: -0.036,
            dec_rate_deg_per_century: -0.004,
            w0_deg: 8.95,
            w_rate_deg_per_day: 190.6979085,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (300.0, -0.197834360027, 9.66, -1.09, -9.6),
                (316.45, 0.0138590006845, 0.0, 0.0, 2.23),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): no terrain yet, so the margin above the ellipsoid.
        rails_floor: 2000.0,
        heightmap: None,
        sea_level: None,
    ),
)
