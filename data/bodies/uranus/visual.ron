// Uranus's visuals (read by crates/game; physical data is in body.ron).
// base_color: the mean of the colour map, sRGB (Lambert albedo 1.5 p from the geometric albedos in Sloan r', V, Sloan g':
// Mallama et al. 2017, Icarus 282, 19); albedo: Bond albedo, NASA Planetary Fact Sheet (NSSDCA).
// color_map: Hubble OPAL 2025 global maps, calibrated (`asset-tool giants`; docs/features/solar-visuals.md#giants).
(
    base_color: (0.76, 0.87, 0.93),
    color_map: Some("color.jpg"),
    // Procedural cloud detail (D073: crisp at any distance, never a magnified photo): representative
    // values, not measurements: the first warp wavelength, its amplitude, the east-west stretch, the tone.
    clouds: Some((scale_m: 1000000.0, warp: 0.15, stretch: 6.0, contrast: 0.03)),
    albedo: 0.3,
    // Visual geometric albedo, NASA Planetary Fact Sheet (NSSDCA): planetshine at full phase.
    geometric_albedo: Some(0.488),
    roughness: 0.95,
    icon_color: (0.82, 0.98, 1.00),
)
