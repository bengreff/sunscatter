// Uranus. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// J2: Jacobson 2014, AJ 148, 76 (R = 25,559 km). No surface: 1-bar ellipsoid.
(
    physical: (
        name: "Uranus",
        radius_eq: 25559000.0,
        radius_polar: 24973000.0,
        j2: 0.00351068,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 257.311,
            dec_deg: -15.175,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 203.81,
            w_rate_deg_per_day: -501.1600928,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: false,
        rails_floor: 0.0,
        heightmap: None,
        sea_level: None,
    ),
)
