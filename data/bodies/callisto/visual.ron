// Callisto's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour ; albedo: geometric albedo (JPL Horizons) standing in for the Bond albedo.
(
    base_color: (0.42, 0.38, 0.34),
    albedo: 0.17,
    roughness: 0.95,
    icon_color: (0.61, 0.57, 0.54),
    // Zones (crisp-surfaces.md) from k-means centres of the colour map (Voyager-Galileo SSI mosaic 1 km, USGS) in CIELAB;
    // `albedo`: linear reflectance (~645, 555, 470 nm): the body's mean albedo 0.22 (geometric, JPL) times
    // the zone's brightness ratio in the map^0.5 (mosaics are display-stretched), coloured by B-V 0.86, V-R 0.50.
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.3,
        list: [
            (name: "dark cratered plains", source: (44, 44, 44), albedo: Some((0.185, 0.162, 0.134)),
                pattern: (scale_m: 1500.0, contrast: 0.1)),
            (name: "cratered plains", source: (57, 57, 57), albedo: Some((0.236, 0.206, 0.171)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright plains", source: (77, 77, 77), albedo: Some((0.318, 0.279, 0.230)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright ejecta", source: (118, 118, 118), albedo: Some((0.499, 0.437, 0.361)),
                pattern: (scale_m: 600.0, contrast: 0.1)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        // Airless: keep detail out to 40 km (as the Moon).
        fade_m: Some(40000.0),
        rock_color: (0.30, 0.30, 0.29),
    )),
)
