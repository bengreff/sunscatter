// Titan. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2: Cassini, Iess et al. 2010, Science 327, 1367 (31.808e-6 at 2,575 km).
(
    physical: (
        name: "Titan",
        radius_eq: 2574964.993,
        radius_polar: 2574470.0,
        j2: 3.180898823e-05,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 39.4827,
            dec_deg: 83.4279,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 186.5855,
            w_rate_deg_per_day: 22.5769768,
        ),
        atmosphere: Some((
            // Skeleton (solar-system.md): an exponential, isothermal at the surface.
            // Huygens HASI at the surface: 1,467 hPa, 93.65 K (Fulchignoni et al. 2005,
            // Nature 438, 785); 95.1 % N2, 4.9 % CH4 near the surface (Niemann et al.
            // 2005): M = 27.426 g/mol, rho0 = 5.167 kg/m3, H = RT/(Mg) = 20.97 km
            // (g = 1.3539). The real scale height grows to 40-50 km in the warmer upper
            // atmosphere (Horst 2017: 15-50 km), so this is far too thin above ~200 km
            // (a HASI table would replace it). N2: gamma 1.4, VHS diameter 4.17e-10 m
            // (Bird 1994), mean free path 1.141e-08 m at the surface; Sutton-Graves for N2.
            rho0: 5.1672, scale_height: 20969.6, p0: 146700.0, molar_mass: 0.027426, gamma: 1.4,
            mean_free_path: 1.1408e-08, top: 600000.0, sutton_graves_k: 1.7415e-4,
        )),
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the top of the atmosphere.
        rails_floor: 600000.0,
        heightmap: None,
        sea_level: None,
    ),
)
