// Haumea's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: geometric 0.51 (Ortiz et al. 2017).
(
    base_color: (0.90, 0.90, 0.90),
    albedo: 0.51,
    roughness: 0.95,
    icon_color: (1.00, 1.00, 1.00),
    // Procedural surface (no global map exists; docs/technical/solar-visuals.md): relief and colour
    // baked by `asset-tool planets` from measured statistics. Zone albedo: linear reflectance at
    // ~645, 555, 470 nm from the geometric albedo 0.51 (Ortiz et al. 2017, Nature 550, 219); neutral, B-V 0.64, V-R 0.33 (MBOSS);
    // colour indices converted with the Sun's B-V 0.653, V-R 0.356. Fresh ejecta: 1.6x (assumed).
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.0,
        list: [
            (name: "terrain", source: (185, 187, 188), albedo: Some((0.498, 0.510, 0.516)),
                pattern: (scale_m: 1000.0, contrast: 0.12)),
            (name: "fresh ejecta", source: (228, 230, 232), albedo: Some((0.797, 0.816, 0.826)),
                pattern: (scale_m: 600.0, contrast: 0.08)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        rock_color: (0.398, 0.408, 0.413),
    )),
)
