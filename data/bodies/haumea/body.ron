// Haumea. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radii: triaxial 1050 x 840 x 537 km (JPL) as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons TNO satellite solutions (2022) and small-body solutions.
(
    physical: (
        name: "Haumea",
        radius_eq: 939148.5505,
        radius_polar: 537000.0,
        j2: 0.0,
        // Pole assumed along Hi'iaka's orbit normal (Ragozzine and Brown 2009 find them close); spin 3.915341 h (JPL).
        rotation: (
            ra_deg: 112.006654,
            dec_deg: -14.573021,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 2206.7043458,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): no terrain yet, so the margin above the ellipsoid.
        rails_floor: 2000.0,
        heightmap: None,
        sea_level: None,
    ),
)
