// Phoebe. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Phoebe",
        radius_eq: 108949.0707,
        radius_polar: 101800.0,
        j2: 0.0,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 356.9,
            dec_deg: 77.8,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 178.58,
            w_rate_deg_per_day: 931.639,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (8696 m) plus 2 km, rounded up.
        rails_floor: 11000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets phoebe` (range -15550 .. 8696 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 10 octaves reach ~1.3 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 10,
            wavelength: 668.5,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
