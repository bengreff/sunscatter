// Nereid. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radius: 170 km (JPL Horizons).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
(
    physical: (
        name: "Nereid",
        radius_eq: 170000.0,
        radius_polar: 170000.0,
        j2: 0.0,
        // Placeholder pole (Neptune's); spin 11.594 h (Kiss et al. 2016, Kepler K2).
        rotation: (
            ra_deg: 299.36,
            dec_deg: 43.46,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 745.213041228,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (7418 m) plus 2 km, rounded up.
        rails_floor: 10000.0,
        // Terrain heights (m) above the reference spheroid, 512×256: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets nereid` (range -9655 .. 7418 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 11 octaves reach ~2.0 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 11,
            wavelength: 2086.2,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
            // Crater-shaped detail (sim::terrain::craters): 5 octaves of cells from the map spacing
            // down to 130 m, 50% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 5, density: 0.5, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
