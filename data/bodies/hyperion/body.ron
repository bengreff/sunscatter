// Hyperion. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radii: IAU WGCCRE 2015 triaxial 180.1 x 133.0 x 102.7 km as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
(
    physical: (
        name: "Hyperion",
        radius_eq: 154768.5369,
        radius_polar: 102700.0,
        j2: 0.0,
        // Placeholder: the rotation is chaotic (Wisdom, Peale and Mignard 1984); Saturn's pole and a 13-day spin, for display only.
        rotation: (
            ra_deg: 40.589,
            dec_deg: 83.537,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 27.6923076923,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (29246 m) plus 2 km, rounded up.
        rails_floor: 32000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets hyperion` (range -32914 .. 29246 m).
        heightmap: Some("height.png"),
        // Metres per stored unit: the relief exceeds the 16-bit range at 1 m.
        height_scale: 2.0,
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 10 octaves reach ~1.9 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 10,
            wavelength: 949.6,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
