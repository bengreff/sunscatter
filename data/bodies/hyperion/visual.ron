// Hyperion's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: geometric ~0.3 (Thomas et al. 2007).
(
    base_color: (0.66, 0.59, 0.50),
    albedo: 0.3,
    roughness: 0.95,
    icon_color: (0.81, 0.75, 0.68),
    // Procedural surface (no global map exists; docs/features/solar-visuals.md): relief and colour
    // baked by `asset-tool planets` from measured statistics. Zone albedo: linear reflectance at
    // ~645, 555, 470 nm from the geometric albedo 0.3 (Thomas et al. 2007, Nature 448, 50); reddish (B-V 0.72, V-R 0.40, Cruikshank et al. 2007);
    // colour indices converted with the Sun's B-V 0.653, V-R 0.356. Fresh ejecta: 1.6x (assumed).
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.0,
        list: [
            (name: "terrain", source: (188, 184, 179), albedo: Some((0.312, 0.300, 0.282)),
                pattern: (scale_m: 1000.0, contrast: 0.12)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        rock_color: (0.250, 0.240, 0.226),
    )),
)
