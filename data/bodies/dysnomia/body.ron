// Dysnomia. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radius: 350 +- 57.5 km (JPL; Brown and Butler 2018).
// GM and orbit: JPL Horizons TNO satellite solutions (2022) and small-body solutions.
(
    physical: (
        name: "Dysnomia",
        radius_eq: 350000.0,
        radius_polar: 350000.0,
        j2: 0.0,
        // Assumed synchronous: pole = its orbit normal, period 15.786 d.
        rotation: (
            ra_deg: 36.15713416,
            dec_deg: 44.4857714,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 22.8051630129,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (3574 m) plus 2 km, rounded up.
        rails_floor: 6000.0,
        // Terrain heights (m) above the reference spheroid, 512×256: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets dysnomia` (range -7409 .. 3574 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~2.1 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 4295.1,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
