// Quaoar. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radii: triaxial 1,241.4 x 1,093.0 x 1,023.0 km diameters (Kiss et al. 2024) as an oblate spheroid.
// Orbit: JPL Horizons small-body solution; GM in sol-systems.ron.
(
    physical: (
        name: "Quaoar",
        radius_eq: 582419.5653,
        radius_polar: 511500.0,
        j2: 0.0,
        // Pole RA 259.6, Dec 53.1, spin 17.6792 h (Kiss et al. 2024, occultations; via Wikipedia).
        rotation: (
            ra_deg: 259.6,
            dec_deg: 53.1,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 488.709896375,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (40022 m) plus 2 km, rounded up.
        rails_floor: 43000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets quaoar` (range -39156 .. 40022 m).
        heightmap: Some("height.png"),
        // Metres per stored unit: the relief exceeds the 16-bit range at 1 m.
        height_scale: 2.0,
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~1.7 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 3573.7,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
            // Crater-shaped detail (sim::terrain::craters): 6 octaves of cells from the map spacing
            // down to 112 m, 20% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 6, density: 0.2, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
