// Quaoar's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: geometric ~0.12 (Braga-Ribas et al. 2013).
(
    base_color: (0.66, 0.47, 0.37),
    albedo: 0.12,
    roughness: 0.95,
    icon_color: (0.81, 0.65, 0.56),
    // Procedural surface (no global map exists; docs/features/solar-visuals.md): relief and colour
    // baked by `asset-tool planets` from measured statistics. Zone albedo: linear reflectance at
    // ~645, 555, 470 nm from the geometric albedo 0.12 (Braga-Ribas et al. 2013); red, B-V 0.94, V-R 0.64 (MBOSS);
    // colour indices converted with the Sun's B-V 0.653, V-R 0.356. Fresh ejecta: 1.6x (assumed).
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.0,
        list: [
            (name: "terrain", source: (188, 167, 148), albedo: Some((0.156, 0.120, 0.092)),
                pattern: (scale_m: 1000.0, contrast: 0.12)),
            (name: "fresh ejecta", source: (232, 206, 183), albedo: Some((0.249, 0.192, 0.147)),
                pattern: (scale_m: 600.0, contrast: 0.08)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        rock_color: (0.125, 0.096, 0.074),
    )),
)
