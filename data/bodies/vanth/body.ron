// Vanth. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radius: 221.5 km (JPL).
// GM and orbit: JPL Horizons TNO satellite solutions (2022) and small-body solutions.
(
    physical: (
        name: "Vanth",
        radius_eq: 221500.0,
        radius_polar: 221500.0,
        j2: 0.0,
        // Assumed synchronous (JPL: "sync"): pole = its orbit normal, period 9.54 d.
        rotation: (
            ra_deg: 323.3577018,
            dec_deg: -14.27871924,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 37.739805011,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (3089 m) plus 2 km, rounded up.
        rails_floor: 6000.0,
        // Terrain heights (m) above the reference spheroid, 512×256: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets vanth` (range -6529 .. 3089 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~1.3 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 2718.2,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
            // Crater-shaped detail (sim::terrain::craters): 6 octaves of cells from the map spacing
            // down to 85 m, 30% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 6, density: 0.3, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
