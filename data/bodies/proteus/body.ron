// Proteus. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Proteus",
        radius_eq: 212941.3065,
        radius_polar: 201000.0,
        j2: 0.0,
        // IAU pole with its periodic terms linearised about 2055: within 0.05 deg of the full series over 2030-2080; prime meridian without its periodic terms
        rotation: (
            ra_deg: 299.2694273,
            dec_deg: 42.33930072,
            ra_rate_deg_per_century: 0.5713891542,
            dec_rate_deg_per_century: 0.2086827491,
            w0_deg: 93.38,
            w_rate_deg_per_day: 320.7654228,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): no terrain yet, so the margin above the ellipsoid.
        rails_floor: 2000.0,
        heightmap: None,
        sea_level: None,
    ),
)
