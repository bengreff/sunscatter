// Io. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2: Galileo, Schubert et al. 2004 (Jupiter, ch. 13, table 13.1: 1859.5e-6 at 1,821.6 km), rescaled.
(
    physical: (
        name: "Io",
        radius_eq: 1824393.148,
        radius_polar: 1815700.0,
        j2: 0.00185379664,
        // IAU series with its periodic terms of at least 0.01 deg (2 of 4): within 8.5e-07 deg (pole) and 0 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 268.05,
            dec_deg: 64.5,
            ra_rate_deg_per_century: -0.009,
            dec_rate_deg_per_century: 0.003,
            w0_deg: 200.39,
            w_rate_deg_per_day: 203.4889538,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (283.9, 0.132804928131, 0.094, 0.04, -0.085),
                (355.8, 0.0326160164271, 0.024, 0.011, -0.022),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (7021 m) plus 2 km, rounded up.
        rails_floor: 10000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM; no impact craters on Io): the triaxial shape and regional fBm (the mountains are not modelled)
        // Baked by `asset-tool planets io` (range -6994 .. 7021 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 14 octaves reach ~1.4 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 14,
            wavelength: 11194.3,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
