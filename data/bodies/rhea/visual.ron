// Rhea's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: Bond albedo ~0.57 (Howett et al. 2010).
(
    base_color: (0.75, 0.74, 0.72),
    albedo: 0.57,
    roughness: 0.95,
    icon_color: (0.89, 0.88, 0.86),
    // Zones (crisp-surfaces.md) from k-means centres of the colour map (Cassini-Voyager mosaic 417 m, USGS) in CIELAB;
    // `albedo`: linear reflectance (~645, 555, 470 nm): the body's mean albedo 0.57 (Bond, Howett et al. 2010) times
    // the zone's brightness ratio in the map^0.5 (mosaics are display-stretched), coloured by B-V 0.78, V-R 0.40.
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.3,
        list: [
            (name: "dark terrain", source: (81, 81, 81), albedo: Some((0.428, 0.411, 0.365)),
                pattern: (scale_m: 1500.0, contrast: 0.1)),
            (name: "cratered plains", source: (101, 101, 101), albedo: Some((0.540, 0.518, 0.461)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright plains", source: (118, 118, 118), albedo: Some((0.640, 0.614, 0.546)),
                pattern: (scale_m: 1000.0, contrast: 0.1)),
            (name: "bright ejecta", source: (143, 143, 143), albedo: Some((0.783, 0.752, 0.669)),
                pattern: (scale_m: 600.0, contrast: 0.1)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        // Airless: keep detail out to 40 km (as the Moon).
        fade_m: Some(40000.0),
        rock_color: (0.30, 0.30, 0.29),
    )),
)
