// Rhea. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radii: the triaxial IAU radii a, b, c as an oblate spheroid (equatorial sqrt(ab), polar c).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured (Cassini flyby solutions disagree).
(
    physical: (
        name: "Rhea",
        radius_eq: 764049.4094,
        radius_polar: 762400.0,
        j2: 0.0,
        // IAU series with its periodic terms of at least 0.01 deg (1 of 8): within 8.5e-07 deg (pole) and 0 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 40.38,
            dec_deg: 83.55,
            ra_rate_deg_per_century: -0.036,
            dec_rate_deg_per_century: -0.004,
            w0_deg: 235.16,
            w_rate_deg_per_day: 79.6900478,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (345.2, -0.0278247775496, 3.1, -0.35, -3.08),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (6466 m) plus 2 km, rounded up.
        rails_floor: 9000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): IAU Gazetteer craters at their positions, a crater population from the measured density, triaxial shape, regional fBm
        // Baked by `asset-tool planets rhea` (range -11665 .. 6466 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~2.3 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 4688.1,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
