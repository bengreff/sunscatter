// Charon. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radius: IAU mean radius (a sphere).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Charon",
        radius_eq: 606000.0,
        radius_polar: 606000.0,
        j2: 0.0,
        // IAU mean rotation (constant and linear terms).
        rotation: (
            ra_deg: 132.993,
            dec_deg: -6.163,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 122.695,
            w_rate_deg_per_day: 56.3625225,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (6863 m) plus 2 km, rounded up.
        rails_floor: 9000.0,
        // Terrain heights (m) above the reference spheroid, 2048×1024: New Horizons stereo DEM (Schenk et al. 2018; USGS, 300 m; the unseen hemisphere filled smoothly), via asset-tool planets
        // Baked by `asset-tool planets charon` (range -14058 .. 6863 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 11 octaves reach ~1.8 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 11,
            wavelength: 1859.2,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
        )),
        sea_level: None,
    ),
)
