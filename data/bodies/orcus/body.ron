// Orcus. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Radius: 455 km (JPL).
// GM and orbit: JPL Horizons TNO satellite solutions (2022) and small-body solutions.
(
    physical: (
        name: "Orcus",
        radius_eq: 455000.0,
        radius_polar: 455000.0,
        j2: 0.0,
        // Pole assumed along Vanth's orbit normal; spin 13.188 h (JPL).
        rotation: (
            ra_deg: 323.3577018,
            dec_deg: -14.27871924,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 0.0,
            w_rate_deg_per_day: 655.141037307,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (2359 m) plus 2 km, rounded up.
        rails_floor: 5000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets orcus` (range -5404 .. 2359 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~1.4 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 2791.8,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            // No ridged octaves: crater walls, not mountain crests, make this roughness (they made jagged teeth).
            ridge_threshold: 1.0e9,
            // Crater-shaped detail (sim::terrain::craters): 6 octaves of cells from the map spacing
            // down to 87 m, 20% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/technical/solar-visuals.md).
            craters: Some((octaves: 6, density: 0.2, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
