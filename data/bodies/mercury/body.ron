            dec_deg: 61.4155,
            ra_rate_deg_per_century: -0.0328,
            dec_rate_deg_per_century: -0.0049,
            w0_deg: 329.5988,
            w_rate_deg_per_day: 6.1385108,
        ),
        atmosphere: None,
