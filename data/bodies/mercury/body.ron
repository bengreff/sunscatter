// Mercury. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// J2: NASA Planetary Fact Sheet (NSSDCA, Williams).
(
    physical: (
        name: "Mercury",
        radius_eq: 2440530.0,
        radius_polar: 2438260.0,
        j2: 5.03e-05,
        // IAU series with its periodic terms of at least 0.01 deg (1 of 5): within 8.5e-07 deg (pole) and 0.0012 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 281.0103,
            dec_deg: 61.4155,
            ra_rate_deg_per_century: -0.0328,
            dec_rate_deg_per_century: -0.0049,
            w0_deg: 329.5988,
            w_rate_deg_per_day: 6.1385108,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (174.7910857, 4.092335, 0.0, 0.0, 0.01067257),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (4303 m) plus 2 km, rounded up.
        rails_floor: 7000.0,
        // Terrain heights (m) above the reference spheroid, 4096×2048: MESSENGER MDIS stereo DEM v2 (Becker et al. 2016; USGS, 665 m), via asset-tool planets
        // Baked by `asset-tool planets mercury` (range -6013 .. 4303 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~1.8 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 3743.7,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
            // Crater-shaped detail (sim::terrain::craters): 6 octaves of cells from the map spacing
            // down to 117 m, 40% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 6, density: 0.4, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
