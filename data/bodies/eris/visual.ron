// Eris's visuals (read by crates/game; physical data is in body.ron).
// base_color: an approximate visual colour (drawn without maps); albedo: geometric 0.96 (Sicardy et al. 2011).
(
    base_color: (0.95, 0.95, 0.94),
    albedo: 0.96,
    roughness: 0.95,
    icon_color: (1.00, 1.00, 1.00),
    // Procedural surface (no global map exists; docs/features/solar-visuals.md): relief and colour
    // baked by `asset-tool planets` from measured statistics. Zone albedo: linear reflectance at
    // ~645, 555, 470 nm from the geometric albedo 0.96 (Sicardy et al. 2011, Nature 478, 493); B-V 0.78, V-R 0.45 (MBOSS, Hainaut et al. 2012);
    // colour indices converted with the Sun's B-V 0.653, V-R 0.356. Fresh ejecta: 1.6x (assumed).
    color_map: Some("color.jpg"),
    zones: Some((
        map: "zones.png",
        tint: 0.0,
        list: [
            (name: "terrain", source: (188, 180, 171), albedo: Some((0.950, 0.950, 0.854)),
                pattern: (scale_m: 1000.0, contrast: 0.12)),
        ],
    )),
    detail: Some((
        scale_m: 25.0,
        strength: 0.55,
        // Airless: keep detail out to 40 km (as the Moon).
        fade_m: Some(40000.0),
        rock_color: (0.760, 0.760, 0.683),
    )),
)
