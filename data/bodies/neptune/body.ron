// Neptune. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// J2: Jacobson 2009, AJ 137, 4322 (3,408.4e-6 at R = 25,225 km, rescaled to 24,764 km). No surface: 1-bar ellipsoid.
(
    physical: (
        name: "Neptune",
        radius_eq: 24764000.0,
        radius_polar: 24341000.0,
        j2: 0.003536480891,
        // IAU pole with its periodic terms linearised about 2055: within 0.013 deg of the full series over 2030-2080; prime meridian without its periodic terms
        rotation: (
            ra_deg: 299.3594273,
            dec_deg: 42.88930072,
            ra_rate_deg_per_century: 0.5713891542,
            dec_rate_deg_per_century: 0.2086827491,
            w0_deg: 249.978,
            w_rate_deg_per_day: 541.1397757,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: false,
        rails_floor: 0.0,
        heightmap: None,
        sea_level: None,
    ),
)
