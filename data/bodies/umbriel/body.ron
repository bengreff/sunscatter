// Umbriel. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radius: IAU mean radius (a sphere).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Umbriel",
        radius_eq: 584700.0,
        radius_polar: 584700.0,
        j2: 0.0,
        // IAU pole with its periodic terms linearised about 2055: within 0.017 deg of the full series over 2030-2080; prime meridian without its periodic terms
        rotation: (
            ra_deg: 257.1842462,
            dec_deg: -14.96879121,
            ra_rate_deg_per_century: 0.07410598956,
            dec_rate_deg_per_century: -0.3174743188,
            w0_deg: 108.05,
            w_rate_deg_per_day: -86.8688923,
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): no terrain yet, so the margin above the ellipsoid.
        rails_floor: 2000.0,
        heightmap: None,
        sea_level: None,
    ),
)
