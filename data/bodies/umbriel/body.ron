// Umbriel. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radius: IAU mean radius (a sphere).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Umbriel",
        radius_eq: 584700.0,
        radius_polar: 584700.0,
        j2: 0.0,
        // IAU series with its periodic terms of at least 0.01 deg (2 of 14): within 1.5e-06 deg (pole) and 4.2e-17 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 257.43,
            dec_deg: -15.1,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 108.05,
            w_rate_deg_per_day: -86.8688923,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (308.71, -0.00255085557837, 0.21, 0.2, 0.06),
                (316.41, 0.0784109514031, 0.0, 0.0, -0.09),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (4453 m) plus 2 km, rounded up.
        rails_floor: 7000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): triaxial shape, craters from the measured density, regional fBm
        // Baked by `asset-tool planets umbriel` (range -7583 .. 4453 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 12 octaves reach ~1.8 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 12,
            wavelength: 3587.7,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
            // Crater-shaped detail (sim::terrain::craters): 6 octaves of cells from the map spacing
            // down to 112 m, 50% of them holding a bowl 0.15 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 6, density: 0.5, depth_ratio: 0.15)),
        )),
        sea_level: None,
    ),
)
