// Triton. The `physical` section is read by the simulation (sim::body::data). Angles in degrees, rates in IAU units.
// Rotation and shape: IAU WGCCRE 2015 (Archinal et al. 2018, CMDA 130:22) as in NAIF pck00011.tpc.
// Radius: IAU mean radius (a sphere).
// GM and orbit: JPL Horizons (satellite ephemerides); this file is size, gravity field and rotation.
// J2 not measured.
(
    physical: (
        name: "Triton",
        radius_eq: 1352600.0,
        radius_polar: 1352600.0,
        j2: 0.0,
        // IAU series with its periodic terms of at least 0.01 deg (9 of 17): within 1.2e-06 deg (pole) and 0 deg (W) of the full series over 2030-2080
        rotation: (
            ra_deg: 299.36,
            dec_deg: 41.17,
            ra_rate_deg_per_century: 0.0,
            dec_rate_deg_per_century: 0.0,
            w0_deg: 296.53,
            w_rate_deg_per_day: -61.2572637,
            // (phase deg, rate deg/day, ra, dec, W amplitudes deg): ra += a sin, dec += b cos, W += c sin.
            librations: [
                (177.85, 0.0014323340178, -32.35, 22.55, 22.25),
                (355.7, 0.00286466803559, -6.28, 2.1, 6.73),
                (533.55, 0.00429700205339, -2.08, 0.55, 2.05),
                (711.4, 0.00572933607118, -0.74, 0.16, 0.74),
                (889.25, 0.00716167008898, -0.28, 0.05, 0.28),
                (1067.1, 0.00859400410678, -0.11, 0.02, 0.11),
                (1244.95, 0.0100263381246, -0.07, 0.01, 0.05),
                (1422.8, 0.0114586721424, -0.02, 0.0, 0.02),
                (1600.65, 0.0128910061602, -0.01, 0.0, 0.01),
            ],
        ),
        atmosphere: None,
        anchor_zone: None,
        relativistic: false,
        solid: true,
        // Rails warp is disabled below this altitude (m, D062): the highest terrain (1080 m) plus 2 km, rounded up.
        rails_floor: 4000.0,
        // Terrain heights (m) above the reference spheroid, 1024×512: procedural relief (no global DEM): IAU Gazetteer craters, a sparse crater population (a young surface), regional fBm
        // Baked by `asset-tool planets triton` (range -1694 .. 1080 m).
        heightmap: Some("height.png"),
        // Procedural detail below the heightmap (D059): RMS residual map (rms_m = value² / 64)
        // and the fractal's parameters; octave 0 is the map's sample spacing, 13 octaves reach ~2.0 m.
        roughness: Some("roughness.png"),
        terrain_detail: Some((
            octaves: 13,
            wavelength: 8299.4,
            lacunarity: 2.0,
            gain: 0.5,
            amplitude: 0.5,
            ridge_threshold: 300.0,
            // Crater-shaped detail (sim::terrain::craters): 7 octaves of cells from the map spacing
            // down to 130 m, 3% of them holding a bowl 0.1 as deep as it is wide (assumed from the
            // body's crater density; docs/features/solar-visuals.md).
            craters: Some((octaves: 7, density: 0.03, depth_ratio: 0.1)),
        )),
        sea_level: None,
    ),
)
