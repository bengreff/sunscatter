// Fluids (D104, docs/design/ship-model.md §3.2; read by sim::fluids).
//
// Liquids: saturated density (K, kg/m³) and vapour pressure (K, Pa) tables,
// specific heat J/(kg·K), latent heat at the normal boiling point J/kg,
// freezing, normal boiling and critical points K, molar mass kg/mol; the
// gas their vapour is. Gases are ideal: molar mass kg/mol, γ and cₚ near
// room temperature. Density is interpolated linearly in T, vapour pressure
// as ln p linear in 1/T, both held at the table's ends.
//
// Provenance: CORE wrote this first set from well-known values (NIST
// Chemistry WebBook, propellant handbooks; 2026-10-26); `verify` lists the
// fields given from memory, for DATA to check against the sources.
(
    liquids: [
        (
            id: "LOX", name: "Liquid oxygen", molar_mass: 0.031999, vapour: Some("oxygen"),
            // Falcon 9 loads it densified near 66 K (−207 °C).
            density: [(55.0, 1303.5), (60.0, 1282.0), (65.0, 1259.7), (70.0, 1237.0), (80.0, 1190.5), (90.0, 1142.1), (100.0, 1090.9), (110.0, 1035.5), (120.0, 973.9), (130.0, 902.5), (140.0, 813.2), (150.0, 675.5)],
            vapour_pressure: [(55.0, 178.6), (60.0, 725.8), (65.0, 2335.0), (70.0, 6262.0), (80.0, 30124.0), (90.0, 99350.0), (100.0, 254005.0), (110.0, 543400.0), (120.0, 1022280.0), (130.0, 1749070.0), (140.0, 2787780.0), (150.0, 4218610.0)],
            specific_heat: 1690.0, latent_heat: 213.1e3,
            freezing_k: 54.36, boiling_k: 90.19, critical_k: 154.58,
            sources: ["NIST Chemistry WebBook, SRD 69: oxygen, saturation properties by temperature (Schmidt & Wagner 1985 equation of state), queried 2026-10-27: saturated-liquid density and vapour pressure at each table point; cp 1.677 kJ/(kg·K) at 66 K to 1.699 at 90.19 K; ΔvapH 6.82 kJ/mol at the normal boiling point"],
            verify: [],
        ),
        (
            id: "RP-1", name: "Rocket propellant 1 (kerosene, MIL-DTL-25576)", molar_mass: 0.1635,
            // Falcon 9 loads it chilled near 266 K (−7 °C).
            density: [(225.0, 854.0), (250.0, 836.0), (266.0, 825.0), (288.7, 808.1), (300.0, 800.0), (350.0, 764.0), (400.0, 727.0)],
            vapour_pressure: [(250.0, 20.0), (300.0, 300.0), (350.0, 2500.0), (400.0, 12000.0), (489.0, 101325.0)],
            specific_heat: 1880.0, latent_heat: 246.0e3,
            freezing_k: 225.0, boiling_k: 489.0, critical_k: 677.0,
            sources: ["MIL-DTL-25576 (RP-1 specification: density 799–815 kg/m³ at 288.7 K)", "Huber, Lemmon, Ott, Bruno, Energy & Fuels 23 (2009) 3083, Table 3 (NIST RP-1 surrogate: M 163.5 g/mol, 808.1 kg/m³ at 288.7 K, initial boiling point 475.6 K, Tc 677 K, pc 2.21 MPa)", "CPIA/M4 Liquid Propellant Manual, RP-1", "Edwards, J. Propulsion and Power 19 (2003), hydrocarbon fuels"],
            // The table is anchored at 288.7 K to Huber (2009); its slope (~0.73 kg/m³ per K) and the boiling point (a mid-distillation value; the initial boiling point is 475.6 K) are still from memory.
            verify: ["density", "vapour_pressure", "specific_heat", "latent_heat", "freezing_k", "boiling_k"],
        ),
        (
            id: "MMH", name: "Monomethylhydrazine", molar_mass: 0.04607,
            density: [(233.0, 928.0), (273.0, 892.0), (293.0, 874.0), (313.0, 856.0), (333.0, 838.0), (353.0, 819.0)],
            vapour_pressure: [(233.0, 40.0), (273.0, 1394.0), (293.0, 4998.0), (313.0, 14145.0), (333.0, 34173.0), (360.6, 101325.0), (400.0, 290000.0)],
            specific_heat: 2930.0, latent_heat: 876.0e3,
            freezing_k: 220.8, boiling_k: 360.6, critical_k: 567.0,
            // 233–333 K from NIST's Antoine fit (log10 p[bar] = 3.96787 − 1115.19/(T − 81.502), fitted 275–298 K, extrapolated); it reaches 1 atm at ~363 K (NIST lists Tboil 364 K, Majer & Svoboda 1985); 360.6 K (87.5 °C) is the handbook value kept as the normal boiling point.
            sources: ["NIST Chemistry WebBook, methylhydrazine (C60344): Ttriple 220.79 K (Aston et al. 1951), ΔvapH 40.37 kJ/mol at 298 K, Antoine parameters (Aston et al. 1951)", "Wikipedia chembox, monomethylhydrazine: 0.875 g/cm³ and 5.00 kPa at 20 °C, Cp 134.93 J/(mol·K), bp 87.5 °C", "CPIA/M4 Liquid Propellant Manual, MMH"],
            verify: ["density", "critical_k"],
        ),
        (
            id: "NTO", name: "Nitrogen tetroxide (N₂O₄, MON-3 class)", molar_mass: 0.092011,
            density: [(263.0, 1510.0), (273.0, 1490.0), (293.0, 1446.0), (313.0, 1401.0), (333.0, 1355.0)],
            vapour_pressure: [(263.0, 15900.0), (273.0, 30100.0), (293.0, 96000.0), (313.0, 257000.0), (333.0, 620000.0)],
            specific_heat: 1550.0, latent_heat: 414.0e3,
            freezing_k: 261.9, boiling_k: 294.3, critical_k: 431.0,
            // 96 kPa at 20 °C (Wikipedia/CRC) with ΔvapH 38.1 kJ/mol gives 1 atm at 294.2 K (Clausius–Clapeyron), so 294.3 K is kept; Wikipedia's 21.69 °C bp disagrees with its own vapour pressure.
            sources: ["CPIA/M4 Liquid Propellant Manual, N2O4", "Wikipedia chembox, dinitrogen tetroxide: 1.44246 g/cm³ at 21 °C, mp −11.2 °C, vapour pressure 96 kPa at 20 °C"],
            verify: ["density", "vapour_pressure", "specific_heat", "latent_heat"],
        ),
        (
            id: "water", name: "Water", molar_mass: 0.018015, vapour: Some("water-vapour"),
            density: [(273.16, 999.8), (277.13, 1000.0), (293.15, 998.2), (313.15, 992.2), (333.15, 983.2), (353.15, 971.8), (373.15, 958.4)],
            vapour_pressure: [(273.16, 611.7), (293.15, 2339.0), (313.15, 7385.0), (333.15, 19950.0), (353.15, 47410.0), (373.15, 101325.0), (393.15, 198700.0)],
            specific_heat: 4182.0, latent_heat: 2257.0e3,
            freezing_k: 273.15, boiling_k: 373.15, critical_k: 647.1,
            sources: ["NIST Chemistry WebBook, water (IAPWS-95)"],
            verify: [],
        ),
    ],
    gases: [
        (id: "helium", name: "Helium", molar_mass: 0.0040026, gamma: 1.667, cp: 5193.0,
            sources: ["NIST Chemistry WebBook, helium"], verify: []),
        (id: "nitrogen", name: "Nitrogen", molar_mass: 0.0280134, gamma: 1.400, cp: 1040.0,
            sources: ["NIST Chemistry WebBook, nitrogen"], verify: []),
        (id: "oxygen", name: "Oxygen", molar_mass: 0.031999, gamma: 1.395, cp: 918.0,
            sources: ["NIST Chemistry WebBook, oxygen"], verify: []),
        (id: "CO2", name: "Carbon dioxide", molar_mass: 0.04401, gamma: 1.289, cp: 844.0,
            sources: ["NIST Chemistry WebBook, carbon dioxide"], verify: []),
        (id: "water-vapour", name: "Water vapour", molar_mass: 0.018015, gamma: 1.33, cp: 1864.0,
            sources: ["NIST Chemistry WebBook, water (ideal gas at 300 K): cp 33.6 J/(mol·K), so γ = 33.6/(33.6 − 8.314) = 1.33"], verify: []),
        (id: "hydrogen", name: "Hydrogen", molar_mass: 0.002016, gamma: 1.405, cp: 14300.0,
            sources: ["NIST Chemistry WebBook, hydrogen"], verify: []),
    ],
)
