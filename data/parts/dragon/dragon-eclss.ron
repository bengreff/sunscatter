            scrubber_flow: 0.015,       // m³/s E (RESEARCH)
            scrubber_efficiency: 0.9,   // single pass E (RESEARCH)
            sorbent: 60.0,              // kg of LiOH D (RESEARCH: four crew, 10 days)
            sorbent_capacity: 0.69,     // kg CO₂ per kg: 0.919 in theory (D), 75 % used (E)
            mass: 300.0)),              // E
