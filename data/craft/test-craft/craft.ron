// The test craft (realism-1 §3a, D060, D064): one part for the whole ship.
// Numbers are placeholders for a small hypergolic craft (Δv ≈ 5.4 km/s full);
// the owner tunes them. Vectors are in body axes (m), +Z = nose and thrust axis.
(
    name: "Test craft",
    crew: 3,                         // crewed: flown without light delay (D063)
    dry_mass: 4000.0,                // kg
    propellant: (mass: 16000.0, capacity: 16000.0),   // one bipropellant, kg
    engine: (
        thrust_vac: 300.0e3,         // N
        isp_vac: 320.0, isp_sl: 280.0,   // s; Isp and thrust fall with ambient pressure
        min_throttle: 0.1,
        gimbal_deg: 5.0,
        mount: (pos: (0.0, 0.0, -5.9), dir: (0.0, 0.0, 1.0)),   // the bell's throat; thrust along +Z
        // D077: of the jet power (½·F·vₑ ≈ 470 MW), 0.5–5 % crosses the
        // walls (Sutton & Biblarz, Rocket Propulsion Elements), most of it
        // near the throat. The chamber's share goes back into the flow
        // (regenerative cooling), so it heats nothing. The radiatively
        // cooled extension (the bell) takes 0.22 % (~1 MW): its equilibrium
        // is then ~1400 K, where coated niobium extensions run (C-103 limit
        // ~1640 K). The bell joins the craft only at the throat.
        nozzle_heat_fraction: 2.2e-3,
    ),
    // D078: RCS only (no wheels). Apollo SM RCS thrusters (Marquardt
    // R-4D, 445 N, Isp ~290 s in pulses; Apollo Operations Handbook) in
    // fore and aft rings of four quads on the hull: pitch/yaw couples
    // 2·445·9.0 = 8.0 kN·m, roll 8·445·1.04 = 3.7 kN·m, drawing 0.63 kg/s
    // (pitch, yaw) and 1.25 kg/s (roll) of the main propellant at full.
    attitude_control: (rcs: (thrust: 445.0, isp: 290.0, fore_z: 3.6, aft_z: -5.4, radius: 1.04)),
    // At the nose: under the chute the rocket hangs tail down, on its legs.
    // Four Apollo-class mains (25.4 m ringsails; Apollo's three brought
    // ~5.9 t down at ~9 m/s, NASA TN D-7437: Cd·A ~390 m² each). Sized for
    // the landing mass (dry 4 t + 1 t reserve) at ~7 m/s, under the legs'
    // 8 m/s (Soyuz's main: 7.2 m/s, ESA). A full 20 t craft comes down at
    // ~14 m/s: land light or on the engine.
    chute: (cd_area: 1560.0, deploy_max_q: 40.0e3, mount: (0.0, 0.0, 6.8)),
    // Subsonic Cd on the projected area: a slender body's end-on ~0.3 (base
    // drag included) plus the legs, feet and fin edges; ~1 broadside is the
    // Newtonian distribution's (the aero model scales the shape's).
    aero: (cd0: 0.45),
    // D065 (revised): skin cells and interior volume nodes on a 1 m grid.
    // Any cell above skin_max_k or node above internal_max_k destroys the
    // craft. The interior: the dry mass less the skin (~2.8 t of structure
    // and equipment) spread by volume at ~0.9 kJ/(kg·K), and the propellant
    // where it sits in the tank (NTO/MMH ≈ 1.5–2.9 kJ/(kg·K): 2.0). Nodes
    // conduct through an effective 5 W/(m·K) (sparse aluminium structure);
    // skin to the node beneath through insulation and frames at 2 W/(m²·K).
    thermal: (
        skin_max_k: 1100.0, internal_max_k: 400.0,
        node_size: 1.0, interior_specific_heat: 900.0, propellant_specific_heat: 2000.0,
        interior_conductivity: 5.0, internal_coupling: 2.0,
    ),
    impact: (max_speed: 8.0),        // m/s at any contact point, beyond the gear's stroke
    // Ground contact (D066). Feet: 20 t on four feet sink ~12 cm on Earth
    // (~2 cm on the Moon), damped at ζ ≈ 0.28 per foot full (2.5e4 over
    // 2·√(4e5·5000)), ~0.6 empty: a touchdown bounces visibly (restitution
    // ~0.4 full). The stroke stops 0.35 m above the engine bell. Hull:
    // stiff; a foot past its stroke uses it too.
    contact: (
        foot: (stiffness: 4.0e5, damping: 2.5e4, stroke: 0.35, friction: 0.8),   // N/m, N·s/m, m
        hull: (stiffness: 2.0e6, damping: 1.0e5, friction: 0.5),
        stick_speed: 0.05,           // m/s: friction is viscous below this sliding speed
    ),
    antenna: (gain_dbi: 20.0, power_w: 20.0),                // D068
)
