// The test craft's shape (D074, realism-1 §3a): primitives in body axes (m),
// +Z = nose and thrust axis. A finned rocket, 2 m across and ~14.5 m long:
// an engine bell under a flared skirt, a cylindrical body with the tank in
// its forward half and the crew cabin under a conical nose with a rounded
// tip, four thin tail fins, and four fixed legs from the fins' tips. Overlapping primitives are fine: surfaces inside another
// primitive are removed when the craft is built.
//
// Stable nose-first at every Mach number: below M 5 the fins' lift and the
// flare's area growth put the centre of pressure aft of the centre of mass;
// in hypersonic (Newtonian) flow the fins carry little, and the flare's
// normal force, linear in incidence and at the base, outweighs the nose
// cone's. Free molecular: the side area behind the CoM (fins, skirt).
(
    // Skin of every primitive unless it names its own (D065 thermal data):
    // aluminium, 3 mm.
    skin: (areal_mass: 8.1, specific_heat: 900.0, emissivity: 0.8, conductivity: 150.0, thickness: 0.003),
    // Where the propellant sits (a solid cylinder filling from `base` along
    // `axis`; mass properties, realism-1 §3a): 16 t of NTO/MMH (≈1.2 t/m³)
    // is ~13.3 m³, 4.7 m of a 0.95 m-radius cylinder.
    tank: (base: (0.0, 0.0, -1.0), axis: (0.0, 0.0, 4.7), radius: 0.95),
    primitives: [
        (
            name: "engine bell",
            shape: Frustum(base: (0.0, 0.0, -7.0), axis: (0.0, 0.0, 1.1), r_base: 0.8, r_top: 0.35),
            // The radiatively cooled nozzle extension (D077): niobium alloy
            // C-103, 1 mm, silicide coating (ε ≈ 0.7–0.82; C-103 service
            // limit ≈ 1640 K). It is joined to the craft only at the throat
            // (the chamber and its gimbal mount): ~1 W/K in all.
            skin: Some((
                areal_mass: 8.6, specific_heat: 270.0, emissivity: 0.8, conductivity: 50.0, thickness: 0.001,
                max_k: Some(1640.0), coupling: Some(0.2),
            )),
            nozzle: true,
        ),
        (name: "skirt", shape: Frustum(base: (0.0, 0.0, -6.0), axis: (0.0, 0.0, 1.5), r_base: 1.52, r_top: 1.04)),
        (name: "body", shape: Cylinder(base: (0.0, 0.0, -5.8), axis: (0.0, 0.0, 9.8), radius: 1.04)),
        (
            name: "cabin",
            shape: Frustum(base: (0.0, 0.0, 4.0), axis: (0.0, 0.0, 2.4), r_base: 1.04, r_top: 0.49),
            // The crew cabin's pressure shell and equipment: heavier than
            // the tank's skin (it carries the dry mass forward).
            skin: Some((areal_mass: 60.0, specific_heat: 900.0, emissivity: 0.8, conductivity: 150.0, thickness: 0.02)),
        ),
        (name: "nose", shape: SphereCap(center: (0.0, 0.0, 6.296), axis: (0.0, 0.0, 1.0), radius: 0.5, height: 0.604)),
        (name: "fin +X", shape: Box(center: (1.8, 0.0, -4.6), half: (1.0, 0.04, 1.3))),
        (name: "fin +Y", shape: Box(center: (0.0, 1.8, -4.6), half: (0.04, 1.0, 1.3))),
        (name: "fin -X", shape: Box(center: (-1.8, 0.0, -4.6), half: (1.0, 0.04, 1.3))),
        (name: "fin -Y", shape: Box(center: (0.0, -1.8, -4.6), half: (0.04, 1.0, 1.3))),
        // Legs from the fins' tips down to the feet (on the axes, so the
        // mesh keeps the craft's symmetry).
        (name: "leg +X", shape: Strut(from: (2.6, 0.0, -5.4), to: (3.2, 0.0, -7.58), radius: 0.08)),
        (name: "leg +Y", shape: Strut(from: (0.0, 2.6, -5.4), to: (0.0, 3.2, -7.58), radius: 0.08)),
        (name: "leg -X", shape: Strut(from: (-2.6, 0.0, -5.4), to: (-3.2, 0.0, -7.58), radius: 0.08)),
        (name: "leg -Y", shape: Strut(from: (0.0, -2.6, -5.4), to: (0.0, -3.2, -7.58), radius: 0.08)),
        (name: "foot +X", shape: Cylinder(base: (3.2, 0.0, -7.7), axis: (0.0, 0.0, 0.12), radius: 0.3), foot: true),
        (name: "foot +Y", shape: Cylinder(base: (0.0, 3.2, -7.7), axis: (0.0, 0.0, 0.12), radius: 0.3), foot: true),
        (name: "foot -X", shape: Cylinder(base: (-3.2, 0.0, -7.7), axis: (0.0, 0.0, 0.12), radius: 0.3), foot: true),
        (name: "foot -Y", shape: Cylinder(base: (0.0, -3.2, -7.7), axis: (0.0, 0.0, 0.12), radius: 0.3), foot: true),
    ],
)
