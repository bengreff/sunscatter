#!/usr/bin/env bash
# Run the game.
#
#   ./run           the game (release build)
#   ./run dev       faster rebuilds while iterating (Bevy dynamic linking; never for releases)
#   ./run play      the 2026-10-01 low-orbit playtest save (in its own home dir; Cmd+L at the pad)
#   ./run headless [port]  no window: an agent drives it through MCP at http://127.0.0.1:<port>/mcp
#                   (default 7777, token "dev"), developer tools on, a fresh home dir (a mission test, D122)
#
# Environment variables still apply, e.g. `SUNSCATTER_PROFILE=1 ./run` (see CLAUDE.md).
set -euo pipefail
cd "$(dirname "$0")"

mode=${1:-}
case "$mode" in
  "" | --) features=() ;;
  dev) features=(--features dev); shift ;;
  play)
    shift
    home=${TMPDIR:-/tmp}/sunscatter-play
    mkdir -p "$home/saves"
    cp docs/plans/playtest-2026-10-01-orbit.ron "$home/saves/quicksave.ron"
    export SUNSCATTER_HOME=$home
    echo "Playtest save ready: Cmd+L (Ctrl+Alt+L off a Mac) at the pad loads it (saves and settings in $home)."
    features=()
    ;;
  headless)
    shift
    port=7777
    case "${1:-}" in [0-9]*) port=$1; shift ;; esac
    # A fresh home dir unless one is given (which is kept as it is).
    home=${SUNSCATTER_HOME:-}
    if [ -z "$home" ]; then
      home=${TMPDIR:-/tmp}/sunscatter-headless
      rm -rf "$home"
    fi
    mkdir -p "$home"
    export SUNSCATTER_HOME=$home SUNSCATTER_OFFSCREEN=1 SUNSCATTER_DEV=1 SUNSCATTER_AGENT="$port:dev"
    echo "Headless: MCP at http://127.0.0.1:$port/mcp (Authorization: Bearer dev); shots and saves in $home."
    features=()
    ;;
  -h | --help | help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "unknown mode '$mode' (try ./run help)" >&2; exit 2 ;;
esac
[ "${1:-}" = "--" ] && shift
exec cargo run -p game --release ${features[@]+"${features[@]}"} -- "$@"
